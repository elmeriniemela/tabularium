<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_refresh_wallets" model="ir.cron">
        <field name="name">Refresh Bitcoin Wallets</field>
        <field name="model_id" ref="model_bitcoin_wallet"/>
        <field name="state">code</field>
        <field name="code">model.search([]).refresh()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
