<odoo>
    <record id="tree_wallet_address" model="ir.ui.view">
        <field name="name">bitcoin.wallet.address.list</field>
        <field name="model">bitcoin.wallet.address</field>
        <field name="arch" type="xml">
            <list>
                <field name="wallet_id" optional="show"/>
                <field name="index" optional="show"/>
                <field name="atype" optional="show"/>
                <field name="address" optional="show"/>
                <field name="scripthash" optional="hide"/>
                <field name="scripthash_status" optional="hide"/>
                <field name="balance" optional="show"/>
                <field name="used" widget="boolean_toggle" optional="show"/>
                <field name="transaction_ids" optional="show"/>
                <field name="psbt_ids" widget="many2many_tags" optional="show"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="form_wallet_address" model="ir.ui.view">
        <field name="name">bitcoin.wallet.address.form</field>
        <field name="model">bitcoin.wallet.address</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_psbt)d" type="action" string="Generate PSBT" context="{'default_source_address_id': id}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="wallet_id"/>
                            <field name="address"/>
                            <field name="scripthash"/>
                            <field name="scripthash_status"/>
                            <field name="balance"/>
                            <field name="used" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="write_date"/>
                            <field name="write_uid"/>
                            <field name="index"/>
                            <field name="atype"/>
                        </group>
                    </group>
                    <separator string="Transactions"/>
                    <field name="transaction_ids"/>
                    <separator string="PSBTs"/>
                    <field name="psbt_ids"/>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="search_wallet_address" model="ir.ui.view">
        <field name="name">bitcoin.wallet.address.search</field>
        <field name="model">bitcoin.wallet.address</field>
        <field name="arch" type="xml">
            <search>
                <field name="address"/>
                <field name="wallet_id"/>
                <field name="scripthash"/>
                <separator/>
                <filter string="Used" name="used" domain="[('used', '=', True)]"/>
                <filter string="Unused" name="unused" domain="[('used', '=', False)]"/>
                <separator/>
                <filter string="Has transactions" name="has_transactions" domain="[('transaction_ids', '!=', False)]"/>
                <filter string="No transactions" name="no_transactions" domain="[('transaction_ids', '=', False)]"/>
                <separator/>
                <filter string="Last Updated" name="write_date_filter" date="write_date"/>
                <filter string="Created Date" name="create_date_filter" date="create_date"/>
                <group>
                    <filter string="Wallet" name="group_wallet_id" context="{'group_by': 'wallet_id'}"/>
                    <filter string="Address Type" name="group_atype" context="{'group_by': 'atype'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wallet_address" model="ir.actions.act_window">
        <field name="name">Addresses</field>
        <field name="res_model">bitcoin.wallet.address</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_has_transactions': 1}</field>
    </record>

</odoo>
