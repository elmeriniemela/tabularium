<odoo>
    <record id="tree_key" model="ir.ui.view">
        <field name="name">bitcoin.key.list</field>
        <field name="model">bitcoin.key</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="xpub" optional="hide"/>
                <field name="zpub" optional="hide"/>
                <field name="Zpub" optional="hide"/>
                <field name="name" optional="show"/>
                <field name="derivation" optional="show"/>
                <field name="master_fingerprint" optional="show"/>
                <field name="compromised" optional="show"/>
                <field name="witness_type" optional="show"/>
                <field name="encoding" optional="show"/>
                <field name="wallet_ids" widget="many2many_tags" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="form_key" model="ir.ui.view">
        <field name="name">bitcoin.key.form</field>
        <field name="model">bitcoin.key</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="xpub"/>
                        <field name="zpub"/>
                        <field name="Zpub"/>
                    </group>
                    <group>
                        <group>
                            <field name="derivation"/>
                            <field name="master_fingerprint"/>
                            <field name="compromised"/>
                        </group>
                        <group>
                            <field name="witness_type"/>
                            <field name="encoding"/>
                        </group>
                    </group>
                    <field name="wallet_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="wallet_id" optional="show"/>
                            <field name="script_type" optional="show"/>
                            <field name="multisig" optional="show"/>
                            <field name="transactions" optional="show"/>
                            <field name="balance" optional="show"/>
                            <button name="action_open_wallet" type="object" string="Open"/>
                        </list>
                    </field>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="search_key" model="ir.ui.view">
        <field name="name">bitcoin.key.search</field>
        <field name="model">bitcoin.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="xpub" string="xpub/zpub/Zpub" filter_domain="['|', '|', ('xpub', 'ilike', self), ('zpub', 'ilike', self), ('Zpub', 'ilike', self)]"/>
                <field name="wallet_ids"/>
                <field name="master_fingerprint"/>
                <field name="derivation"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="all" string="All" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <separator/>
                <filter name="compromised" string="Compromised" domain="[('compromised', '=', True)]"/>
                <filter name="not_compromised" string="Not Compromised" domain="[('compromised', '=', False)]"/>
                <group>
                    <filter string="Witness Type" name="group_witness_type" context="{'group_by': 'witness_type'}"/>
                    <filter string="Encoding" name="group_encoding" context="{'group_by': 'encoding'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_key" model="ir.actions.act_window">
        <field name="name">XPUBs</field>
        <field name="res_model">bitcoin.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_all': 1}</field>
    </record>

</odoo>
