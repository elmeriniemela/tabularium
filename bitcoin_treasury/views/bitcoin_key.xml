<odoo>
    <record id="tree_key" model="ir.ui.view">
        <field name="name">bitcoin.key.list</field>
        <field name="model">bitcoin.key</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="multisig"/>
                <field name="witness_type"/>
                <field name="script_type"/>
                <field name="real_derivation_path"/>
                <field name="real_parent_fingerprint"/>
                <field name="encoding"/>
                <field name="wallet_ids" widget="many2many_tags" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="form_key" model="ir.ui.view">
        <field name="name">bitcoin.key.form</field>
        <field name="model">bitcoin.key</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="wif"/>
                    </group>
                    <group>
                        <group>
                            <field name="witness_type"/>
                            <field name="multisig"/>
                            <field name="encoding"/>
                        </group>
                        <group>
                            <field name="script_type"/>
                            <field name="real_derivation_path"/>
                            <field name="real_parent_fingerprint"/>
                            <field name="wallet_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="search_key" model="ir.ui.view">
        <field name="name">bitcoin.key.search</field>
        <field name="model">bitcoin.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="wif"/>
                <field name="wallet_ids"/>
                <separator/>
                <filter name="all" string="All" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <separator/>
            </search>
        </field>
    </record>

    <record id="action_key" model="ir.actions.act_window">
        <field name="name">Extended Public Keys</field>
        <field name="res_model">bitcoin.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_all': 1}</field>
    </record>

</odoo>
