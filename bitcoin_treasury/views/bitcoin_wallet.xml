<odoo>
    <record id="tree_wallet" model="ir.ui.view">
        <field name="name">bitcoin.wallet.list</field>
        <field name="model">bitcoin.wallet</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="script_type"/>
                <field name="multisig"/>
                <field name="transactions"/>
                <field name="balance"/>
            </list>
        </field>
    </record>

    <record id="form_wallet" model="ir.ui.view">
        <field name="name">bitcoin.wallet.form</field>
        <field name="model">bitcoin.wallet</field>
        <field name="arch" type="xml">
            <form>
                <style>
                    .o_list_char {
                        font-family:monospace !important;
                    }
                </style>
                <header>
                    <button name="refresh" type="object" string="Refresh" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="balance"/>
                        </group>
                        <group>
                            <field name="transactions"/>
                            <field name="multisig"/>
                            <field name="sigs_required" invisible="not multisig"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="History">
                            <field name="history_ids">
                                <list editable="top" create="false" limit="1000">
                                    <field name="date" optional="show"/>
                                    <field name="name" optional="show"/>
                                    <field name="amount" decoration-danger="amount &lt; 0" decoration-success="amount &gt; 0" optional="show"/>
                                    <field name="transaction_id" optional="show"/>
                                    <field name="other_wallet_ids" widget="many2many_tags" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Addresses">
                            <group>
                                <group>
                                    <field name="script_type"/>
                                </group>
                                <group>
                                    <field name="address_amount"/>
                                    <field name="gap_limit"/>
                                </group>
                            </group>
                            <button name="refresh_addresses" type="object" string="Refresh addresses" icon="fa-cogs"/>
                            <field name="address_ids">
                                <list>
                                    <field name="index"/>
                                    <field name="atype"/>
                                    <field name="address"/>
                                    <field name="balance"/>
                                    <field name="transaction_ids"/>
                                    <field name="write_date" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Keys">
                            <field name="key_ids">
                                <list editable="top">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key_id"/>
                                    <field name="multisig" readonly="True"/>
                                    <field name="fingerprint" readonly="True"/>
                                    <field name="witness_type" readonly="True"/>
                                    <field name="script_type" readonly="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="search_wallet" model="ir.ui.view">
        <field name="name">bitcoin.wallet.search</field>
        <field name="model">bitcoin.wallet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter string="Has Balance" name="has_balance" domain="[('balance', '!=', 0)]"/>
                <filter string="No Balance" name="no_balance" domain="[('balance', '=', 0)]"/>
                <separator/>
            </search>
        </field>
    </record>

    <record id="action_wallet" model="ir.actions.act_window">
        <field name="name">Wallets</field>
        <field name="res_model">bitcoin.wallet</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_has_balance': 1}</field>
    </record>

</odoo>