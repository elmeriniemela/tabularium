<odoo>
    <record id="entry_list" model="ir.ui.view">
        <field name="name">toggl.entry.list</field>
        <field name="model">toggl.entry</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="rounded_duration" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="start"/>
                <field name="stop"/>
            </tree>
        </field>
    </record>

    <record id="entry_form" model="ir.ui.view">
        <field name="name">toggl.entry.form</field>
        <field name="model">toggl.entry</field>
        <field name="arch" type="xml">
            <form string="odoo Data ">
                <header>
                    <button name="%(export_action)d" string="Export" type="action"/>
                </header>
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="rounded_duration" widget="float_time"/>
                        <field name="duration" widget="float_time"/>
                        <field name="start"/>
                        <field name="stop"/>
                        <field name="toggl_id"/>
                        <field name="export_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="entry_search" model="ir.ui.view">
        <field name="model">toggl.entry</field>
        <field name="arch" type="xml">
            <search string="Toggl Entry">
                <field name="name"/>
                <field name="description"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="duration"/>
                <field name="toggl_id"/>
                <field name="export_id"/>
                <separator/>
                <filter string="Not Exported" name="not_exported" domain="['|', ('export_id', '=', False), ('export_id', '=', 0)]" />
                <separator/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="entry_action">
        <field name="name">Toggl Sync</field>
        <field name="res_model">toggl.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_not_exported': 1}</field>
    </record>

    <menuitem name="Toggl Sync" id="menu_root" action="entry_action" web_icon="toggl_sync,static/description/icon.png"/>
    <menuitem name="Import" parent="menu_root" id="menu_import" action="import_action"/>

</odoo>