<odoo>
    <record id="entry_list" model="ir.ui.view">
        <field name="name">toggl.entry.list</field>
        <field name="model">toggl.entry</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree default_order="date desc, id asc" editable="top" multi_edit="1" decoration-info="not description" decoration-muted="not active" decoration-warning="dirty" decoration-danger="rounded_duration &lt; total_duration">
                <field name="description" width="450px" optional="show"/>
                <field name="name" width="400px" optional="show"/>
                <field name="rounded_duration" widget="float_time" sum="Rounded" optional="show"/>
                <field name="total_duration" widget="float_time" sum="Total" optional="show"/>
                <field name="date" optional="show"/>
                <field name="original_price" optional="hide"/>
                <field name="timesheet_price" optional="hide"/>
                <field name="revenue" optional="show" sum="Total"/>
                <field name="company_currency_id" optional="hide"/>
                <field name="dirty" optional="hide"/>
                <field name="active" optional="hide"/>
                <field name="task_id" optional="hide"/>
                <field name="toggl_id" optional="hide"/>
                <field name="export_id" optional="hide"/>
                <field name="parent_id" optional="hide"/>
                <field name="locked" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="entry_list_buttons" model="ir.ui.view">
        <field name="name">toggl.entry.list.buttons</field>
        <field name="model">toggl.entry</field>
        <field name="mode">primary</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="entry_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='locked']" position="after">
                <button icon="fa-arrow-up" name="action_round_up" type="object" attrs="{'invisible': [('parent_id', '!=', False)]}"/>
                <button icon="fa-bullseye" name="action_reset_rounding" type="object" attrs="{'invisible': [('parent_id', '!=', False)]}"/>
                <button icon="fa-arrow-down" name="action_round_down" type="object" attrs="{'invisible': [('parent_id', '!=', False)]}"/>
                <button string="External Task" name="action_view_task" type="object" attrs="{'invisible': [('parent_id', '!=', False)]}"/>
                <button string="Toggl Entry" name="action_open_form" type="object"/>
            </xpath>
        </field>
    </record>

    <record id="entry_form" model="ir.ui.view">
        <field name="name">toggl.entry.form</field>
        <field name="model">toggl.entry</field>
        <field name="arch" type="xml">
            <form string="odoo Data ">
                <header>
                    <button name="recompute_depends" string="Re-compute" type="object"/>
                    <button name="update_timesheet_price" string="Update Timesheet Price" type="object"/>
                    <button name="export" string="Export" type="object"/>
                    <button name="push_toggl" string="Push to Toggl" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="company_currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="active"/>
                            <field name="original_price"/>
                            <field name="timesheet_price"/>
                            <field name="dirty"/>
                            <field name="toggl_id"/>
                            <field name="export_id"/>
                            <field name="task_id"/>
                            <field name="locked" attrs="{'invisible': [('locked', '=', False)]}"/>
                            <field name="parent_id" attrs="{'invisible': [('parent_id', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="time_period"/>
                            <field name="duration" widget="float_time"/>
                            <field name="extra_duration" widget="float_time"/>
                            <field name="rounded_duration" widget="float_time"/>
                            <field name="total_duration" widget="float_time"/>
                            <field name="export_task_url" widget="url"/>
                        </group>
                    </group>
                    <field name="child_ids"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="entry_kanban" model="ir.ui.view">
        <field name="name">toggl.entry.kanban</field>
        <field name="model">toggl.entry</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left" style="font-weight: bold;">
                                        <field name="description"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="rounded_duration" widget="float_time"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="entry_search" model="ir.ui.view">
        <field name="model">toggl.entry</field>
        <field name="arch" type="xml">
            <search string="Toggl Entry">
                <field name="name"/>
                <field name="description"/>
                <field name="date"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="duration"/>
                <field name="toggl_id"/>
                <field name="export_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="not_active" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Today" name="not_today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Before Today" name="not_today" domain="[('date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Exported" name="exported" domain="[('export_id', '!=', False)]"/>
                <filter string="Not Exported" name="not_exported" domain="[('export_id', '=', False)]"/>
                <separator/>
                <filter string="Show Children" name="parent_id" domain="[('parent_id', '!=', False)]"/>
                <filter string="Hide Children" name="not_parent_id" domain="[('parent_id', '=', False)]"/>
                <separator/>
                <filter string="Zero" name="zero" domain="[('rounded_duration', '=', 0.0)]"/>
                <filter string="Hide Zero" name="not_zero" domain="[('rounded_duration', '!=', 0.0)]"/>
                <separator/>
                <filter string="Description" name="not_description" domain="[('description', '!=', False)]"/>
                <filter string="No description" name="not_description" domain="[('description', '=', False)]"/>
                <separator/>
                <filter string="Price Changed" name="price_changed" domain="[('price_changed', '=', True)]"/>
                <separator/>
                <group expand="1" string="Group by">
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Task" name="group_task_id" context="{'group_by': 'task_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="push_toggl_action" model="ir.actions.server">
        <field name="name">Push to Toggl</field>
        <field name="model_id" ref="model_toggl_entry"/>
        <field name="binding_model_id" ref="model_toggl_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.push_toggl()</field>
    </record>

    <record id="export_action" model="ir.actions.server">
        <field name="name">Export to External</field>
        <field name="model_id" ref="model_toggl_entry"/>
        <field name="binding_model_id" ref="model_toggl_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.export()</field>
    </record>

    <record id="update_timesheet_price_action" model="ir.actions.server">
        <field name="name">Update Timesheet Price</field>
        <field name="model_id" ref="model_toggl_entry"/>
        <field name="binding_model_id" ref="model_toggl_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.update_timesheet_price()</field>
    </record>

    <record id="lock_action" model="ir.actions.server">
        <field name="name">Lock</field>
        <field name="model_id" ref="model_toggl_entry"/>
        <field name="binding_model_id" ref="model_toggl_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.lock()</field>
    </record>

    <record id="unlock_action" model="ir.actions.server">
        <field name="name">Unlock</field>
        <field name="model_id" ref="model_toggl_entry"/>
        <field name="binding_model_id" ref="model_toggl_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.unlock()</field>
    </record>

    <record id="recompute_depends_action" model="ir.actions.server">
        <field name="name">Re-compute</field>
        <field name="model_id" ref="model_toggl_entry"/>
        <field name="binding_model_id" ref="model_toggl_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.recompute_depends()</field>
    </record>



    <record model="ir.actions.act_window" id="entry_action">
        <field name="name">Toggl Entries</field>
        <field name="res_model">toggl.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="context">
            {
                'search_default_not_exported': 1,
                'search_default_not_parent_id': 1,
            }
        </field>
    </record>

    <record model="ir.actions.act_window" id="simple_entry_action">
        <field name="name">Simplified Toggl Entries</field>
        <field name="res_model">toggl.entry</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('entry_list')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="context">
            {
                'search_default_not_exported': 1,
                'search_default_not_parent_id': 1,
            }
        </field>
    </record>



    <menuitem name="Toggl Sync" id="menu_root" action="entry_action" web_icon="toggl_sync,static/description/icon.png" sequence="2"/>
    <menuitem name="Entries" parent="menu_root" id="menu_entries" action="entry_action" sequence="1"/>
    <menuitem name="Simplified Entries" parent="menu_root" id="menu_simple_entries" action="simple_entry_action" sequence="2"/>
    <menuitem name="Import Entries" parent="menu_root" id="menu_import" action="import_action" sequence="3"/>

</odoo>