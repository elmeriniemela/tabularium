<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="after">
                <group name="toggl" string="Toggl">
                    <field name="toggl_api_token" string="API Token"/>
                    <field name="toggl_export_url" string="Export URL"/>
                    <field name="toggl_export_dbname" string="Export DB"/>
                    <field name="toggl_export_uid" string="Export UID"/>
                    <field name="toggl_export_pwd" string="Export PW"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
