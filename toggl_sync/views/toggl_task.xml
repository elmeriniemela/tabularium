<odoo>
    <record id="task_list" model="ir.ui.view">
        <field name="name">toggl.task.list</field>
        <field name="model">toggl.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="project_name" optional="show"/>
                <field name="sale_line_name" optional="show"/>
                <field name="last_entry" widget="timeago" optional="show"/>
                <field name="entry_ids" optional="show"/>
                <field name="task_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="sale_line_id" optional="hide"/>
                <field name="create_uid" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="write_uid" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="task_form" model="ir.ui.view">
        <field name="name">toggl.task.form</field>
        <field name="model">toggl.task</field>
        <field name="arch" type="xml">
            <form string="odoo Data ">
                <header>
                    <button name="fetch_tasks" string="Fetch" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="sale_line_name"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="sale_line_id"/>
                            <field name="last_entry"/>
                        </group>
                    </group>
                    <field name="entry_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="task_search" model="ir.ui.view">
        <field name="model">toggl.task</field>
        <field name="arch" type="xml">
            <search string="Toggl Task">
                <field name="name"/>
                <field name="task_id"/>
                <field name="sale_line_name"/>
                <field name="sale_line_id"/>
                <field name="project_name"/>
                <field name="project_id"/>
                <separator/>
                <filter string="Has Entries" name="entries" domain="[('last_entry', '!=', False)]"/>
                <filter string="No Entries" name="no_entries" domain="[('last_entry', '=', False)]"/>
                <separator/>
                <filter name="last_entry_filter" string="Latest Entry" date="last_entry"/>
                <filter name="create_date_filter" string="Created On" date="create_date"/>
                <filter name="write_date_filter" string="Updated On" date="write_date"/>
                <group>
                    <filter string="Project" name="group_project_name" context="{'group_by': 'project_name'}"/>
                    <filter string="Sale Order Line" name="group_sale_line_name" context="{'group_by': 'sale_line_name'}"/>
                    <filter string="Latest Entry" name="group_last_entry" context="{'group_by': 'last_entry:month'}"/>
                    <filter string="Created On" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="task_action" model="ir.actions.act_window">
        <field name="name">Toggl Tasks</field>
        <field name="res_model">toggl.task</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_entries': 1}</field>
    </record>

    <record id="fetch_action" model="ir.actions.server">
        <field name="name">Update From External</field>
        <field name="model_id" ref="model_toggl_task"/>
        <field name="binding_model_id" ref="model_toggl_task"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.fetch_tasks()</field>
    </record>

    <menuitem name="Tasks" parent="menu_root" id="menu_tasks" action="task_action" sequence="3"/>

</odoo>