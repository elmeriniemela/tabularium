<odoo>
    <record id="task_list" model="ir.ui.view">
        <field name="name">toggl.task.list</field>
        <field name="model">toggl.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="project_name"/>
            </tree>
        </field>
    </record>

    <record id="task_form" model="ir.ui.view">
        <field name="name">toggl.task.form</field>
        <field name="model">toggl.task</field>
        <field name="arch" type="xml">
            <form string="odoo Data ">
                <header>
                    <button name="fetch" string="Fetch" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="sale_line_name"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="sale_line_id"/>
                        </group>
                    </group>
                    <field name="entry_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="task_search" model="ir.ui.view">
        <field name="model">toggl.task</field>
        <field name="arch" type="xml">
            <search string="Toggl Task">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="task_action" model="ir.actions.act_window">
        <field name="name">Toggl Tasks</field>
        <field name="res_model">toggl.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="fetch_action" model="ir.actions.server">
        <field name="name">Update From External</field>
        <field name="model_id" ref="model_toggl_task"/>
        <field name="binding_model_id" ref="model_toggl_task"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.fetch()</field>
    </record>

    <menuitem name="Tasks" parent="menu_root" id="menu_tasks" action="task_action" sequence="3"/>

</odoo>