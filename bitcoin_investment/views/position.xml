<odoo>
    <record id="position_form" model="ir.ui.view">
        <field name="model">investment.position</field>
        <field name="inherit_id" ref="investment_portfolio.position_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Wallets" invisible="1">
                    <field name="wallet_count" invisible="1"/>
                    <field name="wallet_ids" groups="bitcoin_browser.group_bitcoin_user"/>
                </page>
            </xpath>
            <xpath expr="//button[@name='run_integration']" position="after">
                <button name="fetch_bitcoin_transactions" type="object" string="Fetch Bitcoin Transactions" icon="fa-btc" invisible="wallet_count == 0"/>
            </xpath>
        </field>
    </record>


</odoo>