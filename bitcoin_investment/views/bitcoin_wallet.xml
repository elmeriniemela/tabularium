<odoo>
    <record id="tree_wallet" model="ir.ui.view">
        <field name="model">bitcoin.wallet</field>
        <field name="inherit_id" ref="bitcoin_treasury.tree_wallet"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="after">
                <field name="position_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="form_wallet" model="ir.ui.view">
        <field name="model">bitcoin.wallet</field>
        <field name="inherit_id" ref="bitcoin_treasury.form_wallet"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="after">
                <field name="position_id" optional="hide"/>
            </xpath>
        </field>
    </record>


    <record id="action_sync_investments" model="ir.actions.server">
        <field name="name">sync_investments</field>
        <field name="model_id" ref="model_bitcoin_wallet"/>
        <field name="binding_model_id" ref="model_bitcoin_wallet"/>
        <field name="state">code</field>
        <field name="code">records.sync_investments()</field>
    </record>

</odoo>