<odoo>
    <record id="tree_tx_out" model="ir.ui.view">
        <field name="name">bitcoin.tx.out.list</field>
        <field name="model">bitcoin.tx.out</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="tx_id" optional="hide"/>
                <field name="n" optional="show"/>
                <field name="type" optional="show"/>
                <field name="address" optional="show"/>
                <field name="asm" optional="show"/>
                <field name="script_pub_key_hex" optional="hide"/>
                <field name="value" optional="show"/>
                <field name="spent_input_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="form_tx_out" model="ir.ui.view">
        <field name="name">bitcoin.tx.out.form</field>
        <field name="model">bitcoin.tx.out</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="tx_id" invisible="not context.get('show_all')"/>
                            <field name="n"/>
                            <field name="type"/>
                            <field name="address"/>
                            <field name="asm" optional="show"/>
                            <field name="script_pub_key_hex"/>
                            <field name="value"/>
                            <field name="spent_input_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="search_tx_out" model="ir.ui.view">
        <field name="name">bitcoin.tx.out.search</field>
        <field name="model">bitcoin.tx.out</field>
        <field name="arch" type="xml">
            <search>
                <field name="address"/>
                <field name="tx_id"/>
                <field name="type"/>
                <field name="spent_input_id"/>
                <group>
                    <filter string="Transaction" name="group_tx_id" context="{'group_by': 'tx_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tx_out" model="ir.actions.act_window">
        <field name="name">Outputs</field>
        <field name="res_model">bitcoin.tx.out</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'show_all': True}</field>
    </record>

</odoo>
