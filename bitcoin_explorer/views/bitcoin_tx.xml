<odoo>
    <record id="tree_tx" model="ir.ui.view">
        <field name="name">bitcoin.tx.list</field>
        <field name="model">bitcoin.tx</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="txid" optional="show"/>
                <field name="locktime" optional="show"/>
                <field name="size" optional="show"/>
                <field name="vsize" optional="show"/>
                <field name="fee" optional="show"/>
                <field name="block_id" optional="hide"/>
                <field name="blocktime" optional="hide"/>
                <field name="hash" optional="hide"/>
                <field name="version" optional="hide"/>
                <field name="weight" optional="hide"/>
                <field name="in_active_chain" widget="boolean_toggle" optional="hide"/>
                <field name="is_visualized" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="form_tx" model="ir.ui.view">
        <field name="name">bitcoin.tx.form</field>
        <field name="model">bitcoin.tx</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="refresh" type="object" string="Refresh" icon="fa-cogs" context="{'force_tx_refresh': True}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="txid"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="block_id"/>
                            <field name="blocktime"/>
                            <field name="version"/>
                            <field name="size"/>
                            <field name="vsize"/>
                            <field name="weight"/>
                            <field name="locktime"/>
                            <field name="fee"/>
                        </group>
                        <group>
                            <field name="hash"/>
                            <field name="hex"/>
                        </group>
                    </group>
                    <label for="visualized_script" string="Script Visualized"/>
                    <field name="visualized_script"/>
                    <label for="vin_ids" string="Inputs"/>
                    <field name="vin_ids"/>
                    <label for="vout_ids" string="Outputs"/>
                    <field name="vout_ids"/>
                    <label for="spent_input_ids" string="Spent In"/>
                    <field name="spent_input_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="search_tx" model="ir.ui.view">
        <field name="name">bitcoin.tx.search</field>
        <field name="model">bitcoin.tx</field>
        <field name="arch" type="xml">
            <search>
                <field name="txid" filter_domain="[('txid', '=', self)]"/>
                <field name="hash"/>
                <field name="block_id"/>
                <separator/>
                <filter string="In Active Chain" name="in_active_chain" domain="[('in_active_chain', '=', True)]"/>
                <filter string="Not In Active Chain" name="not_in_active_chain" domain="[('in_active_chain', '=', False)]"/>
                <separator/>
                <filter string="Block Time" name="blocktime_filter" date="blocktime"/>
                <group>
                    <filter string="Block" name="group_block_id" context="{'group_by': 'block_id'}"/>
                    <filter string="Block Time" name="group_blocktime" context="{'group_by': 'blocktime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tx" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">bitcoin.tx</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
