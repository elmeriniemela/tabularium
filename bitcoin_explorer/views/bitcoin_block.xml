<odoo>
    <record id="tree_block" model="ir.ui.view">
        <field name="name">bitcoin.block.list</field>
        <field name="model">bitcoin.block</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="hash" optional="show"/>
                <field name="height" optional="show"/>
                <field name="time" optional="show"/>
                <field name="mediantime" optional="show"/>
                <field name="n_tx" optional="show"/>
                <field name="confirmations" optional="hide"/>
                <field name="version" optional="hide"/>
                <field name="merkleroot" optional="hide"/>
                <field name="nonce" optional="hide"/>
                <field name="bits" optional="hide"/>
                <field name="difficulty" optional="hide"/>
                <field name="chainwork" optional="hide"/>
                <field name="computed_n_tx" optional="hide"/>
                <field name="all_tx_fetched" widget="boolean_toggle" optional="hide"/>
                <field name="previousblockhash" optional="hide"/>
                <field name="size" optional="hide"/>
                <field name="strippedsize" optional="hide"/>
                <field name="weight" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="form_block" model="ir.ui.view">
        <field name="name">bitcoin.block.form</field>
        <field name="model">bitcoin.block</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="refresh" type="object" string="Refresh" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="hash"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="confirmations"/>
                            <field name="height"/>
                            <field name="merkleroot"/>
                            <field name="previousblockhash"/>
                        </group>
                        <group>
                            <field name="time"/>
                            <field name="mediantime"/>
                            <field name="n_tx"/>
                            <field name="difficulty"/>
                            <field name="chainwork"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="tx_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="search_block" model="ir.ui.view">
        <field name="name">bitcoin.block.search</field>
        <field name="model">bitcoin.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="hash" filter_domain="[('hash', '=', self)]"/>
                <field name="height"/>
                <field name="merkleroot"/>
                <field name="previousblockhash"/>
                <separator/>
                <filter string="All TX Fetched" name="all_tx_fetched" domain="[('all_tx_fetched', '=', True)]"/>
                <filter string="Not All TX Fetched" name="not_all_tx_fetched" domain="[('all_tx_fetched', '=', False)]"/>
                <separator/>
                <filter string="Time" name="time_filter" date="time"/>
                <filter string="Median Time" name="mediantime_filter" date="mediantime"/>
                <group>
                    <filter string="Time" name="group_time" context="{'group_by': 'time:day'}"/>
                    <filter string="Version" name="group_version" context="{'group_by': 'version'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_refresh" model="ir.actions.server">
        <field name="name">Refresh</field>
        <field name="model_id" ref="model_bitcoin_block"/>
        <field name="binding_model_id" ref="model_bitcoin_block"/>
        <field name="state">code</field>
        <field name="code">records.refresh()</field>
    </record>

    <record id="action_compute_computed_n_tx" model="ir.actions.server">
        <field name="name">Compute N TX</field>
        <field name="model_id" ref="model_bitcoin_block"/>
        <field name="binding_model_id" ref="model_bitcoin_block"/>
        <field name="state">code</field>
        <field name="code">records._compute_computed_n_tx()</field>
    </record>

    <record id="action_block" model="ir.actions.act_window">
        <field name="name">Blocks</field>
        <field name="res_model">bitcoin.block</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>