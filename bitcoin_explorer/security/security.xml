<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_bitcoin">
        <field name="name">Bitcoin</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_bitcoin"/>
    </record>

    <record id="group_bitcoin_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_bitcoin"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">User.</field>
    </record>

    <record id="group_bitcoin_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator.</field>
        <field name="privilege_id" ref="res_groups_privilege_bitcoin"/>
        <field name="implied_ids" eval="[(4, ref('group_bitcoin_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


</odoo>
