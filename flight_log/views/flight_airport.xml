<odoo>
    <record id="airport_list" model="ir.ui.view">
        <field name="name">flight.airport.list</field>
        <field name="model">flight.airport</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="airport_form" model="ir.ui.view">
        <field name="name">flight.airport.form</field>
        <field name="model">flight.airport</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>



    <record id="airport_action" model="ir.actions.act_window">
        <field name="name">Airports</field>
        <field name="res_model">flight.airport</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <menuitem id="airport_menu" parent="log_menu" action="airport_action" sequence="4"/>

</odoo>