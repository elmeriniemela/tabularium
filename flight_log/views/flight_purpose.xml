<odoo>
    <record id="purpose_list" model="ir.ui.view">
        <field name="name">flight.purpose.list</field>
        <field name="model">flight.purpose</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="purpose_form" model="ir.ui.view">
        <field name="name">flight.purpose.form</field>
        <field name="model">flight.purpose</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>



    <record id="purpose_action" model="ir.actions.act_window">
        <field name="name">Flight Purposes</field>
        <field name="res_model">flight.purpose</field>
        <field name="view_mode">list,kanban,form</field>
    </record>


</odoo>