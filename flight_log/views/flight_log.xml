<odoo>
    <record id="log_list" model="ir.ui.view">
        <field name="name">flight.log.list</field>
        <field name="model">flight.log</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree default_order="date desc, start_time desc, id desc" multi_edit="1">
                <field name="name" optional="show"/>
                <field name="purpose_id" widget="selection" optional="show"/>
                <field name="departure_method" optional="show"/>
                <field name="plane_id" optional="show"/>
                <field name="airport_takeoff_id" optional="show"/>
                <field name="airport_landing_id" optional="show"/>
                <field name="date" optional="show"/>
                <field name="start_time" widget="float_time" optional="show"/>
                <field name="end_time" widget="float_time" optional="show"/>
                <field name="duration" widget="float_time" optional="show" sum="Total Duration"/>
                <field name="state" optional="show"/>
                <field name="instrumental_time" widget="float_time" optional="hide" sum="Total Instrumental"/>
                <field name="skip_validation" optional="hide" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="log_form" model="ir.ui.view">
        <field name="name">flight.log.form</field>
        <field name="model">flight.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Description of flight..."  readonly="state == 'confirmed'"/>
                        </h1>
                    </div>
                    <group>
                        <field name="purpose_id" widget="selection" readonly="state == 'confirmed'"/>
                        <field name="departure_method" readonly="state == 'confirmed'"/>
                        <field name="plane_id" readonly="state == 'confirmed'"/>
                        <field name="date"  readonly="state == 'confirmed'"/>
                        <label for="airport_takeoff_id" string="Airport"/>
                        <div class="o_row">
                            <field name="airport_takeoff_id" readonly="state == 'confirmed'"/>
                            <i class="fa fa-long-arrow-right mx-1" aria-label="Arrow icon" title="Arrow"/>
                            <field name="airport_landing_id" readonly="state == 'confirmed'"/>
                        </div>
                        <label for="start_time" string="Time"/>
                        <div class="o_row">
                            <field name="start_time" options="{'type': 'time'}" widget="float_time" readonly="state == 'confirmed'"/>
                            <i class="fa fa-long-arrow-right mx-1" aria-label="Arrow icon" title="Arrow"/>
                            <field name="end_time" options="{'type': 'time'}" widget="float_time" readonly="state == 'confirmed'"/>
                        </div>
                        <field name="duration" widget="float_time" readonly="state == 'confirmed'"/>
                        <field name="instrumental_time" options="{'type': 'time'}" widget="float_time"  readonly="state == 'confirmed'"/>
                        <field name="signatory_license_number"  readonly="state == 'confirmed'"/>
                        <field name="sign" widget="signature"  readonly="state == 'confirmed'"/>
                        <field name="company_id" readonly="state == 'confirmed'"/>
                        <field name="skip_validation" widget="boolean_toggle"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="log_kanban" model="ir.ui.view">
        <field name="name">flight.log.kanban</field>
        <field name="model">flight.log</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_order="date desc, start_time desc, id desc">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click_edit">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="purpose_id"/>
                                            <span>: </span>
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="mt-2">
                                            <field name="plane_id"/>,
                                            <field name="departure_method"/>,
                                            <field name="airport_takeoff_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="date" widget="date"/>, <field name="start_time" widget="float_time"/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="end_time" class="me-2" widget="float_time"/>
                                </div>
                                <div class="o_kanban_record_bottom" t-if="!selection_mode">
                                    <div class="oe_kanban_bottom_left">
                                        <div t-attf-class="oe_kanban_align badge" t-att-title="title">
                                            Duration: <field name="duration" widget="float_time"/>
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right" t-if="!selection_mode">
                                        <div t-attf-class="oe_kanban_align badge" t-att-title="title">
                                            <field name="instrumental_time" widget="float_time"/>
                                            instrumental time.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="log_pivot" model="ir.ui.view">
        <field name="name">flight.log.pivot</field>
        <field name="model">flight.log</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="duration" type="measure"/>
                <field name="instrumental_time" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="log_graph" model="ir.ui.view">
        <field name="name">flight.log.graph</field>
        <field name="model">flight.log</field>
        <field name="priority" eval="2" />
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="log_search" model="ir.ui.view">
        <field name="model">flight.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="search_date" string="Partial date (i.e. 2015-05-)"/>
                <field name="search_start_time" string="Start Time"/>
                <field name="search_end_time" string="End Time"/>
                <field name="plane_id"/>
                <field name="airport_takeoff_id"/>
                <field name="purpose_id"/>
                <field name="departure_method"/>
                <filter name="date" string="Date" date="date"/>

                <separator/>
                <filter string="Skip Validation" name="skip_validation" domain="[('skip_validation', '=', True)]"/>
                <separator/>

                <group expand="1" string="Group by">
                    <filter string="Name" name="group_name" context="{'group_by': 'name'}"/>
                    <filter string="Purpose" name="group_purpose" context="{'group_by': 'purpose_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Plane" name="group_plane_id" context="{'group_by': 'plane_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="log_action" model="ir.actions.act_window">
        <field name="name">Flight Log</field>
        <field name="res_model">flight.log</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="context">{
            'search_default_group_date': 1,
            'pivot_measures': ['__count__', 'duration', 'instrumental_time'],
        }</field>
    </record>

    <record id="report_action" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">flight.log</field>
        <field name="view_mode">graph,pivot,tree,form</field>
        <field name="context">{
            'search_default_group_date': 1,
            'pivot_measures': ['__count__', 'duration', 'instrumental_time'],
        }</field>
    </record>



</odoo>