<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base.module_category_flight_log" model="ir.module.category">
        <field name="sequence">9</field>
    </record>

    <record id="res_groups_privilege_flight_log" model="res.groups.privilege">
        <field name="name">Flight Log</field>
        <field name="category_id" ref="base.module_category_flight_log"/>
    </record>

    <record id="group_flight_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_flight_log"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">User.</field>
    </record>

    <record id="group_flight_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator.</field>
        <field name="privilege_id" ref="res_groups_privilege_flight_log"/>
        <field name="implied_ids" eval="[(4, ref('group_flight_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="comp_rule_flight_plane" model="ir.rule">
        <field name="name">flight_plane company rule</field>
        <field name="model_id" ref="model_flight_plane"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_flight_airport" model="ir.rule">
        <field name="name">flight_airport company rule</field>
        <field name="model_id" ref="model_flight_airport"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_flight_log" model="ir.rule">
        <field name="name">flight_log company rule</field>
        <field name="model_id" ref="model_flight_log"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>


</odoo>
