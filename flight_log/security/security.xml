<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base.module_category_flight_log" model="ir.module.category">
        <field name="sequence">9</field>
    </record>

    <record id="group_flight_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="base.module_category_flight_log"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">User.</field>
    </record>

    <record id="group_flight_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator.</field>
        <field name="category_id" ref="base.module_category_flight_log"/>
        <field name="implied_ids" eval="[(4, ref('group_flight_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


</odoo>
