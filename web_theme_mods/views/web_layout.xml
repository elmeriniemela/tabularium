<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_favicon" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">'/web_theme_mods/static/img/odoo-icon-16x16.ico'</attribute>
        </xpath>
    </template>
</odoo>
