<odoo>

    <record id="cloud_restore_form" model="ir.ui.view">
        <field name="model">cloud.restore</field>
        <field name="arch" type="xml">
            <form>
                <h2>Restore backup to instance</h2>
                <group>
                    <field name="method"/>
                    <field name="backup_id"/>
                    <field name="instance_id"/>
                </group>
                <footer>
                    <button name="action_restore" string="Restore" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="cloud_restore_action" model="ir.actions.act_window">
        <field name="name">Restore</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cloud.restore</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>