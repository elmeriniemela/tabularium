<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dns_zonerecord_list" model="ir.ui.view">
        <field name="model">dns.zone.record</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="rtype" optional="show"/>
                <field name="name" optional="show"/>
                <field name="content" optional="show"/>
                <field name="proxied" widget="boolean_toggle" optional="show"/>
                <field name="readonly" widget="boolean_toggle" optional="show"/>
                <field name="ttl" optional="show"/>
                <field name="zone_id" optional="hide"/>
                <field name="instance_id" optional="hide"/>
                <field name="identifier" optional="hide"/>
                <field name="sequence" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dns_zone_record_form" model="ir.ui.view">
        <field name="model">dns.zone.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="zone_id" required="0"/>
                            <field name="rtype"/>
                            <field name="content"/>
                            <field name="identifier"/>
                        </group>
                        <group>
                            <field name="ttl"/>
                            <field name="proxied"/>
                            <field name="readonly"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dns_zone_record_search" model="ir.ui.view">
        <field name="model">dns.zone.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="identifier"/>
                <field name="zone_id"/>
                <field name="instance_id"/>
                <field name="rtype"/>
                <field name="content"/>
                <filter name="create_date_filter" date="create_date"/>
                <separator/>
                <filter name="filter_proxied" string="Proxied" domain="[('proxied', '=', True)]"/>
                <filter name="filter_not_proxied" string="Not Proxied" domain="[('proxied', '=', False)]"/>
                <separator/>
                <filter name="filter_readonly" string="Readonly" domain="[('readonly', '=', True)]"/>
                <filter name="filter_not_readonly" string="Not Readonly" domain="[('readonly', '=', False)]"/>
                <group>
                    <filter string="Zone" name="group_zone_id" context="{'group_by': 'zone_id'}"/>
                    <filter string="Instance" name="group_instance_id" context="{'group_by': 'instance_id'}"/>
                    <filter string="Type" name="group_rtype" context="{'group_by': 'rtype'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="dns_zone_record_action" model="ir.actions.act_window">
        <field name="name">DNS Zone Records</field>
        <field name="res_model">dns.zone.record</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>