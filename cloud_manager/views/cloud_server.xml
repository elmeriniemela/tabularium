<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_server_list" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="endpoint_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="cloud_server_form" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_agent_restart" type="object" string="Restart Agent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cloud_server_search" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <group expand="1" string="Group by">
                    <filter string="Endpoint" name="group_endpoint_id" context="{'group_by': 'endpoint_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_server_action" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">cloud.server</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>


</odoo>