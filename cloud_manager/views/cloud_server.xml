<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_server_list" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="endpoint_id" optional="hide"/>
                <field name="ipv4_address"/>
                <field name="ipv6_address"/>
                <field name="restarted"/>
                <field name="branch" optional="show"/>
                <field name="commit" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="cloud_server_form" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Diff" type="action" name="%(cloud_server_diff_form_action)d" context="{'default_server_id': active_id, 'search_default_server_id': active_id}"/>
                    <button name="action_restart_instances" type="object" string="Apply Needed Restarts"/>
                    <button name="action_agent_restart" type="object" string="Restart Agent"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(cloud_server_diff_action)d" context="{'default_server_id': active_id, 'search_default_server_id': active_id}" icon="fa-cogs">
                            <field string="Diffs" name="diff_count" widget="statinfo" options="{'label': 'Diffs'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="ipv4_address"/>
                            <field name="ipv6_address"/>
                        </group>
                        <group>
                            <field name="restarted"/>
                            <field name="branch"/>
                            <field name="commit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instances">
                            <field name="instance_ids"/>
                        </page>
                        <page string="Modules">
                            <field name="module_ids"/>
                        </page>
                        <page string="SSL Renewal">
                            <button name="action_ping_ssl_renewal" type="object" string="Ping SSL renewal"/>
                            <group>
                                <field name="ssl_renewal_ping_now"/>
                                <field name="ssl_renewal_pinged"/>
                                <field name="ssl_renewal_response"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cloud_server_search" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <field name="branch"/>
                <field name="commit"/>
                <group expand="1" string="Group by">
                    <filter string="Endpoint" name="group_endpoint_id" context="{'group_by': 'endpoint_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_server_action" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">cloud.server</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>


</odoo>