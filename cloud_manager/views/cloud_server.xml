<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_server_list" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="endpoint_id" optional="hide"/>
                <field name="ipv4_address" optional="show"/>
                <field name="ipv6_address" optional="show"/>
                <field name="branch" optional="show"/>
                <field name="commit" optional="hide"/>
                <field name="cpu_usage_percent" optional="hide"/>
                <field name="memory_usage_percent" optional="hide"/>
                <field name="restarted" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cloud_server_form" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Diff" type="action" name="%(cloud_server_diff_form_action)d" context="{'default_server_id': id, 'search_default_server_id': id}" invisible="not branch"/>
                    <button name="action_restart_instances" type="object" string="Apply Needed Restarts" invisible="not branch"/>
                    <button name="action_agent_restart" type="object" string="Restart Agent" invisible="not branch"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button invisible="not diff_count" class="oe_stat_button" type="action" name="%(cloud_server_diff_action)d" context="{'default_server_id': id, 'search_default_server_id': id}" icon="fa-cogs">
                            <field string="Diffs" name="diff_count" widget="statinfo" options="{'label': 'Diffs'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="cname"/>
                            <field name="ipv4_address"/>
                            <field name="ipv6_address"/>
                        </group>
                        <group>
                            <field name="branch"/>
                            <field name="commit" invisible="not branch"/>
                            <field name="commit_date" invisible="not branch"/>
                            <field name="restarted" invisible="not branch"/>
                        </group>
                    </group>
                    <group string="Hardware">
                        <group>
                            <field name="cpu_usage_percent"/>
                            <field name="memory_usage_percent"/>
                        </group>
                        <group>
                            <field name="memory_total_gb"/>
                            <field name="memory_available_gb"/>
                            <field name="memory_used_gb"/>
                        </group>
                    </group>
                    <label for="disk_ids"/>
                    <field name="disk_ids">
                        <list create="0" delete="0">
                            <field name="mount"/>
                            <field name="total_gb"/>
                            <field name="used_gb"/>
                            <field name="free_gb"/>
                            <field name="usage_percent"/>
                        </list>
                    </field>
                    <label for="module_ids" invisible="not branch"/>
                    <field name="module_ids" invisible="not branch"/>
                    <label for="instance_ids" invisible="not branch"/>
                    <field name="instance_ids" invisible="not branch"/>
                    <button name="action_ping_ssl_renewal" type="object" string="Ping SSL renewal" invisible="not branch"/>
                    <group invisible="not branch">
                        <field name="ssl_renewal_ping_now"/>
                        <field name="ssl_renewal_pinged"/>
                        <field name="ssl_renewal_response"/>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cloud_server_search" model="ir.ui.view">
        <field name="model">cloud.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <field name="branch"/>
                <field name="commit"/>
                <group>
                    <filter string="Endpoint" name="group_endpoint_id" context="{'group_by': 'endpoint_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_server_action" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">cloud.server</field>
        <field name="view_mode">list,kanban,form</field>
    </record>


</odoo>
