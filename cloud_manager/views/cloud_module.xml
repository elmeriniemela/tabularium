<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_module_list" model="ir.ui.view">
        <field name="model">cloud.module</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="cloud_module_form" model="ir.ui.view">
        <field name="model">cloud.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cloud_module_search" model="ir.ui.view">
        <field name="model">cloud.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group expand="1" string="Group by">
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_module_action" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="res_model">cloud.module</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"></field>
    </record>


</odoo>