<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_module_list" model="ir.ui.view">
        <field name="model">cloud.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="sequence" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cloud_module_form" model="ir.ui.view">
        <field name="model">cloud.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cloud_module_search" model="ir.ui.view">
        <field name="model">cloud.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="create_date_filter" date="create_date"/>
                <group>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_module_action" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="res_model">cloud.module</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context"></field>
    </record>


</odoo>