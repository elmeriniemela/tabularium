<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="cloud_server_diff_list" model="ir.ui.view">
        <field name="model">cloud.server.diff</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="server_id" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="module_id" optional="hide"/>
                <field name="allow_update" optional="hide"/>
                <field name="update_done" optional="hide"/>
                <field name="diff" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cloud_server_diff_form" model="ir.ui.view">
        <field name="model">cloud.server.diff</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_update_server" string="Update Server" type="object" invisible="not allow_update"/>
                </header>
                <field name="server_id" invisible="1"/>
                <field name="module_id" invisible="1"/>
                <field name="allow_update" invisible="1"/>
                <group>
                    <field name="name"/>
                    <field name="create_date" invisible="not create_date"/>
                </group>
                <div>
                    <field name="diff" widget="diff" options="{'maxLength': 2000000}" invisible="not diff"/>
                </div>
                <footer>
                    <button name="action_fetch_diff" string="Fetch" type="object" class="oe_highlight" invisible="diff"/>
                    <button special="cancel" string="Cancel" type="object"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="cloud_server_diff_search" model="ir.ui.view">
        <field name="model">cloud.server.diff</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="server_id"/>
                <field name="module_id"/>
                <field name="diff"/>
                <filter name="create_date_filter" date="create_date"/>
                <separator/>
                <filter name="filter_update_done" string="Updated" domain="[('update_done', '=', True)]"/>
                <filter name="filter_update_not_done" string="Not Updated" domain="[('update_done', '=', False)]"/>
                <group>
                    <filter string="Server" name="group_server_id" context="{'group_by': 'server_id'}"/>
                    <filter string="Module" name="group_module_id" context="{'group_by': 'module_id'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_server_diff_action" model="ir.actions.act_window">
        <field name="name">Server Diffs</field>
        <field name="res_model">cloud.server.diff</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="cloud_server_diff_form_action" model="ir.actions.act_window">
        <field name="name">Diff</field>
        <field name="res_model">cloud.server.diff</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>