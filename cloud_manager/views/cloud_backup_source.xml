<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_backup_source_list" model="ir.ui.view">
        <field name="model">cloud.backup.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="backup_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="cloud_backup_source_form" model="ir.ui.view">
        <field name="model">cloud.backup.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="backup_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cloud_backup_source_search" model="ir.ui.view">
        <field name="model">cloud.backup.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="backup_ids"/>
            </search>
        </field>
    </record>

    <record id="cloud_backup_source_action" model="ir.actions.act_window">
        <field name="name">Backup Sources</field>
        <field name="res_model">cloud.backup.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
