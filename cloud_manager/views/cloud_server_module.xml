<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_server_module_list" model="ir.ui.view">
        <field name="model">cloud.server.module</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="server_id" optional="hide"/>
                <field name="module_id" optional="hide"/>
                <field name="url"/>
                <field name="branch"/>
                <field name="commit"/>
                <field name="commit_date"/>
                <button string="Diff" type="action" name="%(cloud_server_diff_form_action)d" context="{'default_server_id': server_id, 'default_module_id': id, 'search_default_server_id': server_id}"/>
            </list>
        </field>
    </record>

    <record id="cloud_server_module_form" model="ir.ui.view">
        <field name="model">cloud.server.module</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Diff" type="action" name="%(cloud_server_diff_form_action)d" context="{'default_server_id': server_id, 'default_module_id': id, 'search_default_server_id': server_id}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="module_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_id"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="branch"/>
                            <field name="commit"/>
                            <field name="commit_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cloud_server_module_search" model="ir.ui.view">
        <field name="model">cloud.server.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="module_id"/>
                <field name="server_id"/>
                <group expand="1" string="Group by">
                    <filter string="Server" name="group_server_id" context="{'group_by': 'server_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_server_module_action" model="ir.actions.act_window">
        <field name="name">Module installations</field>
        <field name="res_model">cloud.server.module</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_server_id': 1}</field>
    </record>

</odoo>