<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_server_module_list" model="ir.ui.view">
        <field name="model">cloud.server.module</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="url" optional="show"/>
                <field name="branch" optional="show"/>
                <field name="commit" optional="show"/>
                <field name="commit_date" optional="show"/>
                <field name="server_id" optional="hide"/>
                <field name="module_id" optional="hide"/>
                <field name="name" optional="hide"/>
                <field name="active" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
                <button string="Diff" type="action" name="%(cloud_server_diff_form_action)d" context="{'default_server_id': server_id, 'default_module_id': id, 'search_default_server_id': server_id}"/>
            </list>
        </field>
    </record>

    <record id="cloud_server_module_form" model="ir.ui.view">
        <field name="model">cloud.server.module</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Diff" type="action" name="%(cloud_server_diff_form_action)d" context="{'default_server_id': server_id, 'default_module_id': id, 'search_default_server_id': server_id}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="module_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_id"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="branch"/>
                            <field name="commit"/>
                            <field name="commit_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cloud_server_module_search" model="ir.ui.view">
        <field name="model">cloud.server.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="module_id"/>
                <field name="name"/>
                <field name="server_id"/>
                <field name="branch"/>
                <field name="commit"/>
                <field name="url"/>
                <filter name="filter_commit_date" date="commit_date"/>
                <filter name="filter_create_date" date="create_date"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="all" string="All" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <group>
                    <filter string="Server" name="group_server_id" context="{'group_by': 'server_id'}"/>
                    <filter string="Module" name="group_module_id" context="{'group_by': 'module_id'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch'}"/>
                    <filter string="Commit Date" name="group_commit_date" context="{'group_by': 'commit_date:month'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_server_module_action" model="ir.actions.act_window">
        <field name="name">Module installations</field>
        <field name="res_model">cloud.server.module</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_server_id': 1}</field>
    </record>

</odoo>