<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dns_zone_list" model="ir.ui.view">
        <field name="model">dns.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="identifier" optional="show"/>
                <field name="ns_endpoint_id" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dns_zone_form" model="ir.ui.view">
        <field name="model">dns.zone</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="fetch_records" type="object" string="Fetch" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="identifier"/>
                        </group>
                        <group>
                            <field name="ns_endpoint_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Records">
                            <field name="record_ids">
                                <list editable="bottom">
                                    <field name="rtype" optional="show"/>
                                    <field name="name" optional="show"/>
                                    <field name="content" optional="show"/>
                                    <field name="proxied" widget="boolean_toggle" optional="show"/>
                                    <field name="readonly" widget="boolean_toggle" optional="show"/>
                                    <field name="ttl" optional="show"/>
                                    <field name="identifier" optional="hide"/>
                                    <field name="instance_id" optional="hide"/>
                                    <field name="sequence" optional="hide"/>
                                    <field name="create_date" optional="hide"/>
                                    <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                                    <field name="write_date" optional="hide"/>
                                    <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dns_zone_search" model="ir.ui.view">
        <field name="model">dns.zone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="identifier"/>
                <field name="ns_endpoint_id"/>
                <filter name="create_date_filter" date="create_date"/>
                <group>
                    <filter string="Nameservers" name="group_ns_endpoint_id" context="{'group_by': 'ns_endpoint_id'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="dns_zone_action" model="ir.actions.act_window">
        <field name="name">DNS Zones</field>
        <field name="res_model">dns.zone</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context"></field>
    </record>


</odoo>