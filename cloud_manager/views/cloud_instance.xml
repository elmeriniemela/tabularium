<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_instance_list" model="ir.ui.view">
        <field name="model">cloud.instance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="endpoint_id" optional="show"/>
                <field name="uid" optional="show"/>
                <field name="http_port" optional="show"/>
                <field name="gevent_port" optional="show"/>
                <field name="state" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="cloud_instance_form" model="ir.ui.view">
        <field name="model">cloud.instance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,created,restarting,running,paused,exited,dead,removed"/>
                    <button name="action_deploy" type="object" string="Deploy" states="draft,removed"/>
                    <button name="action_start" type="object" string="Start"  states="exited"/>
                    <button name="action_restart" type="object" string="Restart" states="running"/>
                    <button name="action_restart" type="object" string="Restart" states="running"/>
                    <button name="action_reset" type="object" string="Reset" states="exited"/>
                    <button name="action_config" type="object" string="Config" states="running,exited,paused"/>
                    <button name="action_stop" type="object" string="Stop" states="running,restarting,paused"/>
                    <button name="action_remove" type="object" string="Remove" states="exited,dead"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="http_port" required="0" attrs="{'invisible': [('http_port', '=', 0)]}"/>
                        </group>
                        <group>
                            <field name="uid" required="0" attrs="{'invisible': [('uid', '=', False)]}"/>
                            <field name="gevent_port" required="0" attrs="{'invisible': [('gevent_port', '=', 0)]}"/>
                        </group>
                    </group>
                    <label for="config"/>
                    <field name="config" widget="ace"/>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cloud_instance_search" model="ir.ui.view">
        <field name="model">cloud.instance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <group expand="1" string="Group by">
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_instance_action" model="ir.actions.act_window">
        <field name="name">Cloud</field>
        <field name="res_model">cloud.instance</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"></field>
    </record>


</odoo>