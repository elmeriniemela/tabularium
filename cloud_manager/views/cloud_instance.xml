<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="cloud_instance_list" model="ir.ui.view">
        <field name="model">cloud.instance</field>
        <field name="arch" type="xml">
            <list decoration-warning="restart_requested != False" decoration-muted="state == 'removed'" decoration-info="state in ('draft', 'created')" decoration-danger="state in ('exited', 'dead') or latest_backup_missing">
                <field name="name" optional="show"/>
                <field name="uid" optional="show"/>
                <field name="http_port" optional="show"/>
                <field name="gevent_port" optional="show"/>
                <field name="restart_requested" optional="show"/>
                <field name="latest_backup_missing" optional="show"/>
                <field name="state" optional="show"/>
                <field name="server_id" optional="hide"/>
                <field name="cname" optional="hide"/>
                <field name="module_ids" widget="many2many_tags" optional="hide"/>
                <field name="dns_record_ids" widget="many2many_tags" optional="hide"/>
                <field name="backup_ids" widget="many2many_tags" optional="hide"/>
                <field name="restarted" optional="hide"/>
                <field name="protected" optional="hide"/>
                <field name="is_self" optional="hide"/>
                <field name="config" optional="hide"/>
                <field name="upgrade" optional="hide"/>
                <field name="fshealth" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cloud_instance_form" model="ir.ui.view">
        <field name="model">cloud.instance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="created,running,exited,removed" options="{'clickable': '1'}"/>
                    <button name="action_deploy" type="object" string="Deploy" invisible="state not in ['draft', 'removed']"/>
                    <button name="action_start" type="object" string="Start" invisible="state not in ['exited']"/>
                    <button name="action_restart" type="object" string="Restart" invisible="state not in ['running']" help="Restart the Odoo process."/>
                    <button name="action_upgrade" type="object" string="Upgrade" invisible="state not in ['running']" help="This will upgrade all the modules where the manifest version number has increased compared to the database."/>
                    <button name="action_rebuild" type="object" string="Rebuild" invisible="state not in ['exited']" help="The runtime environment will be dropped and recreated, but the database will stay intact."/>
                    <button name="action_restore" type="object" string="Restore" invisible="state not in ['exited']" help="Restore from backup file"/>
                    <button name="action_config" type="object" string="Config" invisible="state not in ['running', 'exited', 'paused']" confirm="Are you sure you want to overwrite the config on this instance?" help="This will overwrite the Odoo config on the server"/>
                    <button name="action_stop" type="object" string="Stop" invisible="state not in ['running', 'restarting', 'paused']"/>
                    <button name="action_backup" type="object" string="Backup" invisible="state not in ['running', 'restarting', 'paused']"/>
                    <button name="action_reset" type="object" string="Reset" invisible="state not in ['exited']" confirm="Are you sure you want to RESET this instance? The database will be dropped and an empty one will created." help="The database will be dropped and an empty one will created."/>
                    <button name="action_remove" type="object" string="Remove" invisible="state not in ['exited', 'dead']" confirm="Are you sure you want to REMOVE this instance? This will delete everything related to the instance from the server including the database and all the configurations." help="his will delete everything related to the instance from the server including the database and all the configurations."/>
                    <button name="action_sync_urls" type="object" string="Sync URLs" help="Sync server and DNS config with the selected URL's"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_id"/>
                            <field name="cname" invisible="1"/>
                            <field name="module_ids" widget="many2many_tags"/>
                            <field name="dns_record_ids" widget="many2many_tags" context="{'default_content': cname, 'default_ttl': 60, 'default_rtype': 'CNAME',  'default_proxied': True}"/>
                            <field name="protected" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="uid" required="0" invisible="not uid"/>
                            <field name="http_port" required="0" invisible="http_port == 0"/>
                            <field name="gevent_port" required="0" invisible="gevent_port == 0"/>
                            <field name="is_self" widget="boolean_toggle"/>
                            <field name="latest_backup_missing" invisible="not latest_backup_missing" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Config">
                            <field name="config" widget="ace"/>
                        </page>
                        <page string="Upgrade">
                            <field name="upgrade"/>
                        </page>
                        <page string="Backups">
                            <button name="action_fshealth" type="object" string="Fetch Filestore Health" invisible="state not in ['running', 'restarting', 'paused', 'exited']"/>
                            <field name="fshealth"/>
                            <field name="backup_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cloud_instance_search" model="ir.ui.view">
        <field name="model">cloud.instance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="uid"/>
                <field name="cname"/>
                <field name="server_id"/>
                <field name="state"/>
                <field name="module_ids"/>
                <field name="dns_record_ids"/>
                <filter name="filter_restart_requested" date="restart_requested"/>
                <filter name="filter_restarted" date="restarted"/>
                <filter name="filter_create_date" date="create_date"/>
                <separator/>
                <filter name="filter_protected" string="Protected" domain="[('protected', '=', True)]"/>
                <filter name="filter_not_protected" string="Not Protected" domain="[('protected', '=', False)]"/>
                <separator/>
                <filter name="filter_is_self" string="Is Self" domain="[('is_self', '=', True)]"/>
                <filter name="filter_not_is_self" string="Not Is Self" domain="[('is_self', '=', False)]"/>
                <separator/>
                <filter name="filter_latest_backup_missing" string="Latest Backup Missing" domain="[('latest_backup_missing', '=', True)]"/>
                <filter name="filter_backup_ok" string="Backup OK" domain="[('latest_backup_missing', '=', False)]"/>
                <group>
                    <filter string="Server" name="group_server_id" context="{'group_by': 'server_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Restart Requested" name="group_restart_requested" context="{'group_by': 'restart_requested:month'}"/>
                    <filter string="Restarted" name="group_restarted" context="{'group_by': 'restarted:month'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_instance_action" model="ir.actions.act_window">
        <field name="name">Instances</field>
        <field name="res_model">cloud.instance</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context"/>
    </record>


</odoo>