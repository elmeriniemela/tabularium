<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_backup_list" model="ir.ui.view">
        <field name="model">cloud.backup</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="timestamp" optional="show"/>
                <field name="instance_id" optional="hide"/>
                <button name="action_restore" type="object" string="Restore"/>
            </tree>
        </field>
    </record>

    <record id="cloud_backup_form" model="ir.ui.view">
        <field name="model">cloud.backup</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_restore" type="object" string="Restore"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="instance_id"/>
                        </group>
                        <group>
                            <field name="timestamp"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cloud_backup_search" model="ir.ui.view">
        <field name="model">cloud.backup</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="instance_id"/>
                <filter name="filter_timestamp" date="timestamp"/>
                <group expand="1" string="Group by">
                    <filter string="Instance" name="group_instance_id" context="{'group_by': 'instance_id'}"/>
                    <filter string="Timestamp" name="group_timestamp" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="cloud_backup_action" model="ir.actions.act_window">
        <field name="name">Backup</field>
        <field name="res_model">cloud.backup</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_group_instance_id': 1}</field>
    </record>


</odoo>