<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="flight_log_portal_template" name="Flight Log Portal" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="flight_log.group_flight_user">
                <!-- Uses backend_url provided in rendering values -->
                <t t-call="portal.portal_back_in_edit_mode"/>
            </t>

            <div class="row mt16">
                <!-- Page content -->
                <div id="quote_content" class="col-12 col-lg justify-content-end">

                    <!-- modal relative to the actions sign and pay -->
                    <div role="dialog" class="modal fade" id="modalaccept">
                        <div class="modal-dialog">
                            <form id="accept" method="POST" t-att-data-order-id="flight_log.id" t-att-data-token="flight_log.access_token" class="js_accept_json modal-content js_website_submit_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <header class="modal-header">
                                    <h4 class="modal-title">Sign Flight Log</h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </header>
                                <main class="modal-body" id="sign-dialog">
                                    <t t-call="portal.signature_form">
                                        <t t-set="mode" t-value="'draw'"/>
                                        <t t-set="call_url" t-value="flight_log.get_portal_url(suffix='/accept')"/>
                                    </t>
                                </main>
                            </form>
                        </div>
                    </div>

                    <!-- status messages -->
                    <div t-if="message == 'sign_ok'" class="alert alert-success alert-dismissible d-print-none" role="status">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <strong>Thank You!</strong>
                        <br/>
                        <span>Flight log has been signed.</span>
                    </div>

                    <!-- main content -->
                    <div t-attf-class="card #{'pb-5' if report_type == 'html' else ''}" id="portal_sale_content">
                        <div t-call="flight_log_portal.flight_log_portal_content"/>
                    </div>

                    <!-- bottom actions -->
                    <div class="row justify-content-center text-center d-print-none pt-1 pb-4">

                        <div class="col-sm-auto mt8">
                            <a role="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalaccept" href="#">
                                <i class="fa fa-check"/>
                                <t>Sign</t>
                            </a>
                        </div>
                        <div class="col-sm-auto mt8">
                            <a role="button" class="btn btn-secondary" href="#discussion"><i class="fa fa-comment"/> Feedback</a>
                        </div>
                    </div>

                    <!-- chatter -->
                    <div id="flight_log_communication" class="mt-4">
                        <h2>History</h2>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div><!-- // #quote_content -->
            </div>
        </xpath>
    </template>


    <template id="flight_log_portal_content" name="Flight Log Portal Content">
        <!-- Intro -->
        <div id="introduction" t-attf-class="pb-2 pt-3 #{'card-header bg-white' if report_type == 'html' else ''}">
            <h2 class="my-0">
                <em t-out="flight_log.name"/>
            </h2>
        </div>

        <div t-attf-class="#{'card-body' if report_type == 'html' else ''}">
            <!-- Informations -->
            <div id="informations">
                <div class="row" id="so_date">
                    <div class="mb-3 col-6">
                        <strong>Purpose:</strong>
                        <span t-field="flight_log.purpose_id"/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Departure Method:</strong>
                        <span t-field="flight_log.departure_method"/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Plane:</strong>
                        <span t-field="flight_log.plane_id"/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Date:</strong>
                        <span t-field="flight_log.date" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Airport:</strong>
                        <span t-field="flight_log.airport_takeoff_id"/>
                        <i class="fa fa-long-arrow-right mx-1" aria-label="Arrow icon" title="Arrow"/>
                        <span t-field="flight_log.airport_landing_id"/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Time:</strong>
                        <span t-field="flight_log.start_time" t-options='{"widget": "float_time"}'/>
                        <i class="fa fa-long-arrow-right mx-1" aria-label="Arrow icon" title="Arrow"/>
                        <span t-field="flight_log.end_time" t-options='{"widget": "float_time"}'/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Duration:</strong>
                        <span t-field="flight_log.duration" t-options='{"widget": "float_time"}'/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Instrumental Time:</strong>
                        <span t-field="flight_log.instrumental_time" t-options='{"widget": "float_time"}'/>
                    </div>
                    <div class="mb-3 col-6" t-if="flight_log.sign">
                        <strong>Signature:</strong>
                        <img t-att-src="image_data_uri(flight_log.sign)" style="max-height: 6rem; max-width: 100%;"/>
                    </div>
                    <div class="mb-3 col-6">
                        <strong>Signatory Name / License number:</strong>
                        <span t-field="flight_log.signatory_license_number"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

</odoo>