<odoo>
    <record id="version_control_list" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="field_id" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
                <field name="model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="reference" optional="hide"/>
                <field name="old_value_text" optional="hide"/>
                <field name="new_value_text" optional="hide"/>
                <field name="version_hash_before" optional="hide"/>
                <field name="version_hash_after" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="version_control_form" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                <notebook>
                    <page string="Diff">
                        <field name="diff" widget="diff" options="{'maxLength': 2000000}"/>
                    </page>
                    <page string="Before">
                        <field name="old_value_text"/>
                    </page>
                    <page string="After">
                        <field name="new_value_text"/>
                    </page>
                    <page string="Details">
                        <group>
                            <group>
                                <field name="reference" widget="reference" string="Record"/>
                                <field name="field_id"/>
                                <field name="version_hash_before"/>
                                <field name="version_hash_after"/>
                            </group>
                            <group></group>
                        </group>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="version_control_search" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="arch" type="xml">
            <search string="Version Control">
                <field name="name"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="field_id"/>
                <field name="create_uid"/>
                <separator/>
                <filter name="create_date_filter" string="Created On" date="create_date"/>
                <group>
                    <filter string="Model" name="group_model" context="{'group_by': 'model'}"/>
                    <filter string="Field" name="group_field_id" context="{'group_by': 'field_id'}"/>
                    <filter string="Created By" name="group_create_uid" context="{'group_by': 'create_uid'}"/>
                    <filter string="Created On" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="version_control_action" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">version.control</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context"/>
    </record>


</odoo>