<odoo>
    <record id="version_control_list" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="version_control_form" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="id" required="False"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="version_control_search" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="arch" type="xml">
            <search>
                <field name="id"/>
            </search>
        </field>
    </record>


    <record id="version_control_action" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">version.control</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"/>
    </record>


</odoo>