<odoo>
    <record id="version_control_list" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="field_id" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="version_control_form" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Diff">
                            <field name="diff" widget="diff" options="{'maxLength': 2000000}"/>
                        </page>
                        <page string="Before">
                            <field name="old_value_text"/>
                        </page>
                        <page string="After">
                            <field name="new_value_text"/>
                        </page>
                        <page string="Details">
                            <group>
                                <group>
                                    <field name="field_id"/>
                                    <field name="version_hash_before"/>
                                    <field name="version_hash_after"/>
                                </group>
                                <group></group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="version_control_search" model="ir.ui.view">
        <field name="model">version.control</field>
        <field name="arch" type="xml">
            <search>
                <field name="model"/>
                <field name="res_id"/>
            </search>
        </field>
    </record>


    <record id="version_control_action" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">version.control</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"/>
    </record>


</odoo>