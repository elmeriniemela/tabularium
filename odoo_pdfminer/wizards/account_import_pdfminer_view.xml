<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="account_pdfminer_import_view" model="ir.ui.view">
        <field name="name">Import pdfminers</field>
        <field name="model">account.pdfminer.import</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Import pdfminers">
                <h2>Select PDF file(s) to import</h2>
                <field name="attachment_ids"  widget="many2many_binary" colspan="2" string="Select Files" nolabel="1"/>
                <footer>
                    <button name="import_file" string="_Import" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_pdfminer_import" model="ir.actions.act_window">
        <field name="name">Import Invoices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.pdfminer.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="account_pdfminer_import_view"/>
    </record>

</odoo>
