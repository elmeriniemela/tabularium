<odoo>
    <record model="ir.ui.view" id="odoo_pdfminer.list">
        <field name="name">odoo_pdfminer list</field>
        <field name="model">odoo.pdfminer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_odoo_view_move_form" model="ir.ui.view">
        <field name="name">odoo.pdfminer.form</field>
        <field name="model">odoo.pdfminer</field>
        <field name="arch" type="xml">
            <form string="odoo Data ">
                <header>
                    <button name="%(action_account_pdfminer_import)d" string="Import Invoices" type="action"/>
                </header>
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="example_pdf_filename" invisible="1"/>
                                <field name="example_pdf" filename="example_pdf_filename"/>
                                <field name="source_text"/>
                                <field name="re_amount_total"/>
                                <field name="re_invoice_date"/>
                                <field name="re_ref"/>
                                <field name="re_payment_ref"/>
                                <field name="product_id"/>
                                <field name="journal_id"/>
                                <field name="partner_id"/>
                                <field name="move_type"/>
                                <field name="result"/>
                            </group>
                        </page>
                        <page string="Imported">
                            <field name="move_ids"/>
                        </page>

                    </notebook>
                    <group>
                    </group>

                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
            </form>
        </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="odoo_pdfminer.action_window">
        <field name="name">Odoo PDF Miner</field>
        <field name="res_model">odoo.pdfminer</field>
        <field name="view_mode">tree,form</field>
    </record>



    <!-- Top menu item -->

    <menuitem name="Odoo PDF Miner" id="odoo_pdfminer.menu_root" action="odoo_pdfminer.action_window"/>

    <!-- menu categories -->
    <!--
    <menuitem name="List" id="odoo_pdfminer.menu_1_list" parent="odoo_pdfminer.menu_1" action="odoo_pdfminer.action_window"/>
    <menuitem name="Server to list" id="odoo_pdfminer" parent="odoo_pdfminer.menu_2" action="odoo_pdfminer.action_server"/>
-->
</odoo>