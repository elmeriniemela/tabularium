<odoo>
    <record id="api_message_list" model="ir.ui.view">
        <field name="model">api.message</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="endpoint_id" optional="show"/>
                <field name="create_uid" optional="show" widget="many2one_avatar_user"/>
                <field name="create_date" optional="show"/>
                <field name="state" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="api_message_form" model="ir.ui.view">
        <field name="model">api.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="produced,consumed,error" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="False"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="content" filename="name"/>
                            <field name="response"/>
                        </group>
                        <group>
                            <field name="params"/>
                            <field name="context"/>
                        </group>
                    </group>
                    <label for="content_preview"/>
                    <field name="content_preview"/>
                    <label for="response_preview"/>
                    <field name="response_preview"/>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="api_message_search" model="ir.ui.view">
        <field name="model">api.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <group expand="1" string="Group by">
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="api_message_action" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="res_model">api.message</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"></field>
    </record>


</odoo>