<odoo>
    <record id="api_message_list" model="ir.ui.view">
        <field name="name">api.message.list</field>
        <field name="model">api.message</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="api_message_form" model="ir.ui.view">
        <field name="name">api.message.form</field>
        <field name="model">api.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_message_search" model="ir.ui.view">
        <field name="model">api.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group expand="1" string="Group by">
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="api_message_action" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">api.message</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"></field>
    </record>

    <menuitem id="api_message_menu" parent="api_endpoint_menu" action="api_message_action" sequence="4"/>

</odoo>