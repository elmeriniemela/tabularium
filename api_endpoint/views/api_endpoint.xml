<odoo>
    <record id="api_endpoint_list" model="ir.ui.view">
        <field name="name">api.endpoint.list</field>
        <field name="model">api.endpoint</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="api_endpoint_form" model="ir.ui.view">
        <field name="name">api.endpoint.form</field>
        <field name="model">api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_endpoint_search" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group expand="1" string="Group by">
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="api_endpoint_action" model="ir.actions.act_window">
        <field name="name">API Endpoint</field>
        <field name="res_model">api.endpoint</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"></field>
    </record>

    <menuitem id="api_endpoint_menu" action="api_endpoint_action" web_icon="api_endpoint,static/description/icon.png" sequence="4"/>

</odoo>