<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="api_endpoint_list" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="direction"/>
                <field name="role"/>
                <field name="comm_method"/>
                <field name="file_format"/>
                <field name="location"/>
                <field name="auto_consume" widget="boolean_toggle"/>
                <field name="auto_commit" widget="boolean_toggle"/>
                <field name="ttl"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="authorization" optional="hide"/>
                <field name="sequence_id" optional="hide"/>
                <field name="msg_count"/>
            </tree>
        </field>
    </record>

    <record id="api_endpoint_form" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run" type="object" string="Run" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" icon="fa-tasks" name="%(api_message_action)d" context="{'default_endpoint_id': id, 'search_default_endpoint_id': id}">
                            <field name="msg_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="authorization"/>
                            <field name="sequence_id" attrs="{'invisible': [('sequence_id', '=', False)]}" required="False"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="auto_consume" widget="boolean_toggle"/>
                            <field name="auto_commit" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="direction"/>
                            <field name="role"/>
                            <field name="comm_method"/>
                            <field name="file_format"/>
                            <field name="ttl"/>
                        </group>
                    </group>
                    <label for="producer"/>
                    <field name="hardcoded_producer" widget="ace" options="{'mode': 'python'}" attrs="{'invisible': [('hardcoded_producer', '=', '')]}"/>
                    <field name="producer" widget="ace" options="{'mode': 'python'}"/>
                    <label for="consumer"/>
                    <field name="consumer" widget="ace" options="{'mode': 'python'}"/>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="api_endpoint_search" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group expand="1" string="Group by">
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="api_endpoint_action" model="ir.actions.act_window">
        <field name="name">API Endpoints</field>
        <field name="res_model">api.endpoint</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context"></field>
    </record>


</odoo>