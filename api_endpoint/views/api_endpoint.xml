<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="api_endpoint_list" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list expand="1" decoration-danger="state == 'error'" decoration-muted="state == 'archived'">
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="usage_field_id" optional="show"/>
                <field name="direction" optional="show"/>
                <field name="role" optional="show"/>
                <field name="comm_method" optional="show"/>
                <field name="file_format" optional="show"/>
                <field name="location" optional="show"/>
                <field name="cron_id" optional="show"/>
                <field name="multi_record" widget="boolean_toggle" optional="show"/>
                <field name="auto_consume" widget="boolean_toggle" optional="show"/>
                <field name="auto_commit" widget="boolean_toggle" optional="show"/>
                <field name="ttl" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="authorization" optional="hide"/>
                <field name="sequence_id" optional="hide"/>
                <field name="state" optional="show"/>
                <field name="msg_count" optional="show"/>
                <field name="http_method" optional="hide"/>
                <field name="response_format" optional="hide"/>
                <field name="url" optional="hide"/>
                <field name="active" optional="hide"/>
                <field name="auto_code" widget="boolean_toggle" optional="hide"/>
                <field name="allow_backoff" widget="boolean_toggle" optional="hide"/>
                <field name="backoff" optional="hide"/>
                <field name="to_skip" optional="hide"/>
                <field name="usage_count" optional="hide"/>
                <field name="cron_interval_number" optional="hide"/>
                <field name="cron_interval_type" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="api_endpoint_form" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,error,archived" options="{'clickable': '1'}"/>
                    <button name="action_execute" type="object" string="Execute" icon="fa-cogs" invisible="role != 'active'"/>
                    <button name="action_test" type="object" string="Test" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" invisible="not usage_count" type="object" icon="fa-download" name="action_view_usage">
                            <field name="usage_count" widget="statinfo" string="Usage"/>
                        </button>
                        <button class="oe_stat_button" type="action" icon="fa-envelope" name="%(api_message_action)d" context="{'default_endpoint_id': id, 'search_default_endpoint_id': id}">
                            <field name="msg_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="action" icon="fa-code-fork" name="%(version_control.version_control_action)d" context="{'search_default_model': 'api.endpoint', 'search_default_res_id': id}">
                            <field name="version_control_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="url" widget="url" invisible="not url"/>
                            <field name="authorization"/>
                            <field name="sequence_id" invisible="not sequence_id" required="False"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cron_id" invisible="role != 'active'" options="{'no_create': 1}"/>
                            <label for="cron_interval_number" string="Execute Every" invisible="not cron_id"/>
                            <div invisible="not cron_id">
                                <field name="cron_interval_number" class="oe_inline"/>
                                <field name="cron_interval_type" class="oe_inline"/>
                            </div>
                            <field name="multi_record" widget="boolean_toggle"/>
                            <field name="auto_consume" widget="boolean_toggle"/>
                            <field name="auto_commit" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="usage_field_id" options="{'no_create': 1}"/>
                            <field name="direction"/>
                            <field name="role"/>
                            <field name="comm_method"/>
                            <field name="http_method" invisible="comm_method != 'http'"/>
                            <field name="file_format"/>
                            <field name="response_format"/>
                            <field name="ttl"/>
                            <field name="auto_code" widget="boolean_toggle"/>
                            <field name="allow_backoff" widget="boolean_toggle"/>
                            <field name="backoff" invisible="not backoff"/>
                            <field name="to_skip" invisible="not backoff"/>
                        </group>
                    </group>
                    <label for="documentation"/>
                    <field name="documentation"/>
                    <label for="test_example"/>
                    <field name="test_example" widget="ace" options="{'mode': 'python'}"/>
                    <label for="xslt" invisible="file_format != 'xml'"/>
                    <field name="xslt" widget="ace" options="{'mode': 'xml'}" invisible="file_format != 'xml'"/>
                    <label for="initiator" invisible="role != 'active'"/>
                    <field name="initiator" widget="ace" options="{'mode': 'python'}" invisible="role != 'active'"/>
                    <label for="producer"/>
                    <field name="hardcoded_producer" widget="ace" options="{'mode': 'python'}" invisible="hardcoded_producer == ''"/>
                    <field name="producer" widget="ace" options="{'mode': 'python'}"/>
                    <label for="consumer"/>
                    <field name="hardcoded_consumer" widget="ace" options="{'mode': 'python'}" invisible="hardcoded_consumer == ''"/>
                    <field name="consumer" widget="ace" options="{'mode': 'python'}"/>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="api_endpoint_search" model="ir.ui.view">
        <field name="model">api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <field name="usage_field_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="comm_method"/>
                <field name="cron_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <filter name="all" string="All" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <separator/>
                <filter string="Multi Record" name="multi_record" domain="[('multi_record', '=', True)]"/>
                <filter string="Single Record" name="single_record" domain="[('multi_record', '=', False)]"/>
                <separator/>
                <filter string="Auto Consume" name="auto_consume" domain="[('auto_consume', '=', True)]"/>
                <filter string="No Auto Consume" name="no_auto_consume" domain="[('auto_consume', '=', False)]"/>
                <separator/>
                <filter string="Auto Commit" name="auto_commit" domain="[('auto_commit', '=', True)]"/>
                <filter string="No Auto Commit" name="no_auto_commit" domain="[('auto_commit', '=', False)]"/>
                <separator/>
                <filter string="Auto Code" name="auto_code" domain="[('auto_code', '=', True)]"/>
                <filter string="No Auto Code" name="no_auto_code" domain="[('auto_code', '=', False)]"/>
                <separator/>
                <filter string="Allow Backoff" name="allow_backoff" domain="[('allow_backoff', '=', True)]"/>
                <filter string="No Backoff" name="no_allow_backoff" domain="[('allow_backoff', '=', False)]"/>
                <separator/>
                <filter string="Created Date" name="create_date_filter" date="create_date"/>
                <filter string="Last Modified Date" name="write_date_filter" date="write_date"/>
                <group>
                    <filter string="Used in" name="group_usage_field_id" context="{'group_by': 'usage_field_id'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Role" name="group_role" context="{'group_by': 'role'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Communication Method" name="group_comm_method" context="{'group_by': 'comm_method'}"/>
                    <filter string="File Format" name="group_file_format" context="{'group_by': 'file_format'}"/>
                    <filter string="User" name="group_user_id" context="{'group_by': 'user_id'}"/>
                    <filter string="Company" name="group_company_id" groups="base.group_multi_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="api_endpoint_action" model="ir.actions.act_window">
        <field name="name">APIs</field>
        <field name="res_model">api.endpoint</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_usage_field_id': 1,}</field>
    </record>


</odoo>
