<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_scan" model="ir.cron">
        <field name="name">File Scanner: Scan</field>
        <field name="model_id" ref="model_file_scanner"/>
        <field name="state">code</field>
        <field name="code">model.scan()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">0</field>
    </record>

    <record id="cron_compute_details" model="ir.cron">
        <field name="name">File Scanner: Compute Details</field>
        <field name="model_id" ref="model_file_scanner"/>
        <field name="state">code</field>
        <field name="code">model.search([])._compute_details()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">0</field>
    </record>

    <record id="cron_export" model="ir.cron">
        <field name="name">File Scanner: Export</field>
        <field name="model_id" ref="model_file_scanner"/>
        <field name="state">code</field>
        <field name="code">model.search([('suffix', 'in', ['jpg', 'jpeg', 'png', 'mp4', 'mov', 'wmv', 'avi', '3gp'])]).export()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">0</field>
    </record>
</odoo>
