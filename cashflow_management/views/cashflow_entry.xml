<odoo>
    <record id="entry_tree" model="ir.ui.view">
        <field name="name">cashflow.entry.list</field>
        <field name="model">cashflow.entry</field>
        <field name="arch" type="xml">
            <list default_order="date desc" multi_edit="1">
                <field name="name" optional="show"/>
                <field name="date"  optional="show"/>
                <field name="amount"  optional="show" sum="Total"/>
                <field name="company_id"  optional="show"/>
                <field name="company_currency_id"  optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="parser_id"  optional="show"/>
            </list>
        </field>
    </record>

    <record id="entry_graph" model="ir.ui.view">
         <field name="name">cashflow.entry.graph</field>
         <field name="model">cashflow.entry</field>
         <field name="arch" type="xml">
             <graph type="bar">
                <field name="amount" type="measure"/>
             </graph>
         </field>
    </record>

    <record id="entry_pivot" model="ir.ui.view">
        <field name="name">cashflow.entry.pivot</field>
        <field name="model">cashflow.entry</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="entry_form" model="ir.ui.view">
        <field name="name">cashflow.entry.form</field>
        <field name="model">cashflow.entry</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="company_currency_id"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="parser_id" />
                            <field name="raw"/>
                            <field name="identifier"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="entry_search" model="ir.ui.view">
        <field name="name">cashflow.entry.search</field>
        <field name="model">cashflow.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_id"/>
                <field name="category_id"/>
                <field name="parser_id"/>
                <field name="date"/>
                <filter name="date_filter" date="date"/>
                <separator />
                <filter string="Positive amount" name="positive" domain="[('amount', '>', 0.0)]" />
                <filter string="Negative amount" name="negative" domain="[('amount', '&lt;', 0.0)]" />
                <separator />
                <filter string="Last Month" name="last_month" domain="[('date', '&gt;=', '-1m =1d'), ('date', '&lt;', '=1d')]"/>
                <filter string="This Month" name="this_month" domain="[('date', '&gt;=', '=1d')]"/>
                <separator />
                <filter name="all" string="All" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <separator />
                <group>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Parser" name="group_parser" context="{'group_by': 'parser_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="entry_action_window" model="ir.actions.act_window">
        <field name="name">Entrys</field>
        <field name="res_model">cashflow.entry</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_group_account': 1,'search_default_group_date': 1,}</field>
    </record>

    <record id="report_action_window" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">cashflow.entry</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_account': 1,'search_default_group_date': 1,}</field>
    </record>

    <menuitem name="Cash Flow" id="root_menu" web_icon="cashflow_management,static/description/icon.png" sequence="3"/>
    <menuitem id="entry_menu" action="entry_action_window" parent="root_menu" sequence="10"/>
    <menuitem id="report_menu" action="report_action_window" parent="root_menu" sequence="11"/>

</odoo>