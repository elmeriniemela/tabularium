<odoo>
    <record id="plan_tree" model="ir.ui.view">
        <field name="name">cashflow.plan.tree</field>
        <field name="model">cashflow.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="create_date"  optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="company_currency_id"  optional="hide"/>
            </tree>
        </field>
    </record>


    <record id="plan_form" model="ir.ui.view">
        <field name="name">cashflow.plan.form</field>
        <field name="model">cashflow.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="create_uid" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="company_currency_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="date" optional="hide"/>
                            <field name="name"/>
                            <field name="amount" sum="Total"/>
                            <field name="balance"/>
                            <field name="company_id" optional="hide"/>
                            <field name="company_currency_id"  optional="hide"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plan_search" model="ir.ui.view">
        <field name="name">cashflow.plan.search</field>
        <field name="model">cashflow.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="create_date"/>
                <filter name="create_date_filter" date="create_date"/>
                <group expand="1" string="Group by">
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="plan_action_window" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">cashflow.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="plan_menu" action="plan_action_window" parent="root_menu" sequence="15"/>

</odoo>