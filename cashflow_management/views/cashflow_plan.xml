<odoo>
    <record id="plan_tree" model="ir.ui.view">
        <field name="name">cashflow.plan.tree</field>
        <field name="model">cashflow.plan</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="date"  optional="show"/>
                <field name="name"/>
                <field name="amount" sum="Total"/>
                <field name="balance"/>
                <field name="company_id" optional="hide"/>
                <field name="company_currency_id"  optional="hide"/>
            </tree>
        </field>
    </record>


    <record id="plan_form" model="ir.ui.view">
        <field name="name">cashflow.plan.form</field>
        <field name="model">cashflow.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="company_currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plan_search" model="ir.ui.view">
        <field name="name">cashflow.plan.search</field>
        <field name="model">cashflow.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <filter name="date_filter" date="date"/>
                <group expand="1" string="Group by">
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="plan_action_window" model="ir.actions.act_window">
        <field name="name">Plan</field>
        <field name="res_model">cashflow.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="plan_menu" action="plan_action_window" parent="root_menu" sequence="15"/>

</odoo>