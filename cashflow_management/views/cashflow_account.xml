<odoo>
    <record id="account_tree" model="ir.ui.view">
        <field name="name">cashflow.account.list</field>
        <field name="model">cashflow.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="parser_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="account_form" model="ir.ui.view">
        <field name="name">cashflow.account.form</field>
        <field name="model">cashflow.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(import_action_window)d" type="action" string="Import"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parser_ids" widget="many2many_tags"/>
                    </group>
                    <field name="entry_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_search" model="ir.ui.view">
        <field name="name">cashflow.account.search</field>
        <field name="model">cashflow.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="account_action_window" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">cashflow.account</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <menuitem id="account_menu" action="account_action_window" parent="root_menu" sequence="20"/>

</odoo>