<odoo>
    <record model="ir.ui.view" id="account_tree">
        <field name="name">cashflow.account.tree</field>
        <field name="model">cashflow.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="parser_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="account_form">
        <field name="name">cashflow.account.form</field>
        <field name="model">cashflow.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parser_ids" widget="many2many_tags"/>
                    </group>
                    <field name="entry_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_search" model="ir.ui.view">
        <field name="name">cashflow.account.search</field>
        <field name="model">cashflow.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="account_action_window">
        <field name="name">Accounts</field>
        <field name="res_model">cashflow.account</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <menuitem id="account_menu" action="account_action_window" parent="root_menu" sequence="20"/>

</odoo>