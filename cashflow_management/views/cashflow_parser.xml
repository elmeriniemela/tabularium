<odoo>

    <record id="import_form" model="ir.ui.view">
        <field name="name">cashflow.import.form</field>
        <field name="model">cashflow.import</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <h2>Import cash flow entries</h2>
                <field name="parser_id" invisible="1"/>
                <field name="attachment_ids"  widget="many2many_binary" colspan="2" string="Select Files" nolabel="1" style="width: 100%"/>
                <footer>
                    <button name="import_file" string="Upload" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="import_action_window" model="ir.actions.act_window">
        <field name="name">Import</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cashflow.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="import_form"/>
    </record>


    <record model="ir.ui.view" id="parser_tree">
        <field name="name">cashflow.parser.tree</field>
        <field name="model">cashflow.parser</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="account_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="parser_form">
        <field name="name">cashflow.parser.form</field>
        <field name="model">cashflow.parser</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(import_action_window)d" type="action" string="Import"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <label for="account_id"/>
                        <div>
                            <field name="account_id"/>
                        </div>
                        <field name="account_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Code">
                            <field name="code" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                        <page string="Parsed Entries">
                            <field name="entry_ids"/>
                        </page>
                        <page string="Imported Files">
                            <field name="attachment_ids"/>
                            <button name="delete_files" type="object" string="Delete files"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="parser_search" model="ir.ui.view">
        <field name="name">cashflow.parser.search</field>
        <field name="model">cashflow.parser</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="parser_action_window">
        <field name="name">Parsers</field>
        <field name="res_model">cashflow.parser</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <menuitem id="parser_menu" action="parser_action_window" parent="root_menu" sequence="40"/>

</odoo>