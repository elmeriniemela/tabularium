<odoo>


    <record id="form_account_fiscal_year" model="ir.ui.view">
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Render Financials" name="render_financials" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" placeholder="Fiscal Year 2018"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="financials_template_id"/>
                        <field name="financials_signature" widget="signature"/>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="search_account_fiscal_year" model="ir.ui.view">
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="date_from_filter" string="Start Date" date="date_from"/>
                <filter name="date_to_filter" string="End Date" date="date_to"/>
                <group>
                    <filter string="Company" name="group_company_id" context="{'group_by': 'company_id'}"/>
                    <filter string="Start Date" name="group_date_from" context="{'group_by': 'date_from:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="list_account_fiscal_year" model="ir.ui.view">
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="financials_template_id" optional="hide"/>
                <field name="place_and_date" optional="hide"/>
                <field name="format_date_from" optional="hide"/>
                <field name="format_date_to" optional="hide"/>
                <field name="format_date_expire" optional="hide"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="action_account_fiscal_year" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">account.fiscal.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No records.
            </p>
        </field>
    </record>


    <menuitem id="menu_account_fiscal_year" parent="account.account_account_menu" action="action_account_fiscal_year"/>

</odoo>