<odoo>

    <record id="action_account_fiscal_year_form" model="ir.ui.view">
        <field name="model">account.fiscal.year</field>
        <field name="inherit_id" ref="account_accountant.action_account_fiscal_year_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="financials_template_id"/>
                <field name="financials_signature" widget="signature"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <header>
                    <button string="Render Financials" name="render_financials" type="object"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="o_attachment_preview"/>
                <chatter/>
            </xpath>

        </field>
    </record>

</odoo>