<odoo>
    <record id="asset_transaction_tree" model="ir.ui.view">
        <field name="name">investment.position.transaction.list</field>
        <field name="model">investment.position.transaction</field>
        <field name="arch" type="xml">
            <list editable="top" limit="40">
                <field name="position_id" optional="hide"/>
                <field name="time"  optional="show"/>
                <field name="quantity" sum="Total"  optional="show"/>
                <field name="payment_currency" optional="show"/>
                <field name="payment" sum="Total" optional="hide"/>
                <field name="ttype" optional="show"/>
                <field name="is_split" optional="hide"/>
                <field name="cash_flow" optional="hide" sum="Total"/>
                <field name="description" optional="show"/>
                <field name="exchange_rate" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="currency_rate_id" optional="hide"/>
                <field name="import_id" optional="hide"/>
                <field name="fee" sum="Total Fee" readonly="True" optional="show"/>
                <field name="profit" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0" optional="show"  digits="[2,2]"/>
                <field name="liquid" optional="hide"/>
                <field name="category_id" optional="hide"/>
                <field name="is_locked" optional="hide"/>
                <field name="prediction" optional="hide" widget="boolean_toggle"/>
                <field name="company_currency_id" optional="hide"/>
                <button title="Details" icon="fa-info-circle" name="open_form" type="object"/>
            </list>
        </field>
    </record>

    <record id="asset_transaction_graph" model="ir.ui.view">
        <field name="name">investment.position.transaction.graph</field>
        <field name="model">investment.position.transaction</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="cash_flow" type="measure"/>
            </graph>
        </field>
   </record>

    <record id="asset_transaction_form" model="ir.ui.view">
        <field name="name">investment.position.transaction.form</field>
        <field name="model">investment.position.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="position_id"/>
                            <field name="move_id"/>
                            <field name="import_id"/>
                            <field name="time"/>
                            <field name="quantity"/>
                            <field name="payment"/>
                            <field name="payment_currency" invisible="not currency_rate_id"/>
                            <field name="exchange_rate"/>
                            <label for="currency_rate_id" invisible="not currency_rate_id"/>
                            <div invisible="not currency_rate_id">
                                <field name="inverse_company_rate" digits="[6,6]" class="oe_inline"/>
                                <span>@</span>
                                <field name="currency_rate_id" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="company_currency_id" invisible="True"/>
                            <field name="fee_currency" readonly="1"/>
                            <field name="fee" readonly="1"/>
                            <field name="profit" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0"/>
                            <field name="bypass_lock" widget="boolean_toggle"/>
                            <field name="is_locked"/>
                            <field name="usage" groups="base.group_no_one"/>
                            <field name="description"/>
                            <field name="external_ref"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="asset_transaction_kanban" model="ir.ui.view">
        <field name="name">investment.position.transaction.kanban</field>
        <field name="model">investment.position.transaction</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="currency_id"/>
                <field name="company_currency_id"/>
                <field name="profit"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="row">
                                <div class="col-12" style="font-weight: bold;">
                                    <field name="ttype"/>,
                                    <field name="payment"/>,
                                    <field name="position_id"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-4">
                                    Time
                                </div>
                                <div class="col-8 text-right">
                                    <span><field name="time"/></span>
                                </div>
                            </div>
                            <div t-if="record.ttype.raw_value === 'buy' || record.ttype.raw_value === 'sell'" class="row">
                                <div class="col-4">
                                    Quantity
                                </div>
                                <div class="col-8 text-right">
                                    <field name="kanban_quantity"/>
                                </div>
                            </div>
                            <div t-if="record.ttype.raw_value === 'buy' || record.ttype.raw_value === 'sell'" class="row">
                                <div class="col-4">
                                    Profit
                                </div>
                                <div class="col-8 text-right">
                                    <div t-att-class="record.profit.raw_value &lt; 0 ? 'text-danger' : 'text-success'">
                                        <field name="profit"/>
                                    </div>
                                </div>
                            </div>
                            <div t-if="record.description.raw_value" class="row">
                                <div class="col-4">
                                    Descrtiption
                                </div>
                                <div class="col-8 text-right">
                                    <span><field name="description"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="asset_transaction_search" model="ir.ui.view">
        <field name="name">investment.position.transaction.search</field>
        <field name="model">investment.position.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="position_id"/>
                <field name="description"/>
                <field name="portfolio_id"/>
                <field name="category_id"/>
                <field name="external_ref"/>
                <separator/>
                <filter name="date_filter" date="time"/>
                <separator/>
                <filter string="Long" name="long" domain="[('quantity', '>', 0.0)]"/>
                <filter string="Short" name="short" domain="[('quantity', '&lt;', 0.0)]"/>
                <filter string="Closed" name="closed" domain="[('quantity', '=', 0.0)]"/>
                <separator/>
                <filter string="Buy" name="buy" domain="[('ttype', '=', 'buy')]"/>
                <filter string="Sell" name="sell" domain="[('ttype', '=', 'sell')]"/>
                <filter string="Cost" name="cost" domain="[('ttype', '=', 'cost')]"/>
                <filter string="Yield" name="yield" domain="[('ttype', '=', 'yield')]"/>
                <separator/>
                <filter string="Liquid Assets" name="liquid" domain="[('liquid', '=', True)]"/>
                <filter string="Illiquid Assets" name="illiquid" domain="[('liquid', '=', False)]"/>
                <separator/>
                <filter string="Record" name="record" domain="[('usage', '=', 'record')]" />
                <filter string="Prediction" name="prediction" domain="[('usage', '=', 'prediction')]"/>
                <filter string="Realized Calculation" name="realized_calc" domain="[('usage', '=', 'realized')]"/>
                <separator/>
                <filter string="Move is set" name="move_set" domain="[('move_id', '!=', False)]" />
                <filter string="Move is not set" name="move_not_set" domain="[('move_id', '=', False)]" />
                <separator />
                <filter string="1 Year" name="1_year" domain="[('time', '&gt;', 'today -365d'), ('time', '&lt;', 'today +365d')]" />
                <filter string="2 Years" name="2_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-2*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=2*365)).strftime('%Y-%m-%d'))]" />
                <filter string="3 Years" name="3_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-3*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=3*365)).strftime('%Y-%m-%d'))]" />
                <filter string="4 Years" name="4_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-4*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=4*365)).strftime('%Y-%m-%d'))]" />
                <filter string="5 Years" name="5_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-5*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=5*365)).strftime('%Y-%m-%d'))]" />
                <filter string="6 Years" name="6_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-6*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=6*365)).strftime('%Y-%m-%d'))]" />
                <filter string="7 Years" name="7_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-7*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=7*365)).strftime('%Y-%m-%d'))]" />
                <filter string="8 Years" name="8_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-8*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=8*365)).strftime('%Y-%m-%d'))]" />
                <filter string="9 Years" name="9_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-9*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=9*365)).strftime('%Y-%m-%d'))]" />
                <filter string="10 Years" name="10_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-10*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=10*365)).strftime('%Y-%m-%d'))]" />
                <group>
                    <filter string="Date" name="group_month" context="{'group_by': 'time:month'}" invisible="not context.get('search_default_group_month')"/>
                    <filter string="Date" name="group_year" context="{'group_by': 'time:year'}" invisible="not context.get('search_default_group_year')"/>
                    <filter string="Portfolio" name="group_portfolio_id" context="{'group_by': 'portfolio_id'}"/>
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}"/>
                    <filter string="Type" name="group_ttype" context="{'group_by': 'ttype'}"/>
                    <filter string="Position" name="group_position_id" context="{'group_by': 'position_id'}"/>
                    <filter string="Time" name="group_time" context="{'group_by': 'time:day'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_fill_daily_price" model="ir.actions.server">
        <field name="name">Create prices based on exchange rates</field>
        <field name="model_id" ref="model_investment_position_transaction"/>
        <field name="binding_model_id" ref="model_investment_position_transaction"/>
        <field name="state">code</field>
        <field name="code">records._fill_daily_price()</field>
    </record>

    <record id="action_make_move" model="ir.actions.server">
        <field name="name">Make a move</field>
        <field name="model_id" ref="model_investment_position_transaction"/>
        <field name="binding_model_id" ref="model_investment_position_transaction"/>
        <field name="state">code</field>
        <field name="code">action = records.make_move()</field>
    </record>

    <record id="action_find_move" model="ir.actions.server">
        <field name="name">Find a move</field>
        <field name="model_id" ref="model_investment_position_transaction"/>
        <field name="binding_model_id" ref="model_investment_position_transaction"/>
        <field name="state">code</field>
        <field name="code">action = records.find_move()</field>
    </record>


    <record id="action_transactions_per_month" model="ir.actions.act_window">
        <field name="name">Transactions per month</field>
        <field name="res_model">investment.position.transaction</field>
        <field name="view_mode">graph,list,kanban,form</field>
        <field name="context">{'search_default_group_month': 1, 'search_default_group_position_id': 1, 'search_default_liquid': 1, 'search_default_1_year': 1, 'search_default_record': 1}</field>
    </record>

    <record id="action_yearly_savings" model="ir.actions.act_window">
        <field name="name">Yearly savings</field>
        <field name="res_model">investment.position.transaction</field>
        <field name="view_mode">graph,list,kanban,form</field>
        <field name="context">{'search_default_liquid': 1, 'search_default_group_year': 1, 'search_default_record': 1}</field>
    </record>

    <record id="action_transaction_list" model="ir.actions.act_window">
        <field name="name">Transaction list</field>
        <field name="res_model">investment.position.transaction</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_record': 1}</field>
    </record>


</odoo>
