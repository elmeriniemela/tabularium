<odoo>
    <record model="ir.ui.view" id="asset_transaction_tree">
        <field name="name">investment.asset.transaction.tree</field>
        <field name="model">investment.asset.transaction</field>
        <field name="arch" type="xml">
            <tree editable="top" decoration-success="profit &gt; 0.0" decoration-danger="profit &lt; 0.0">
                <field name="time"/>
                <field name="quantity" sum="Total"/>
                <field name="cash_flow"/>
                <field name="payment_or_refund" optional="hide" sum="Total"/>
                <field name="description"/>
                <field name="exchange_rate"/>
                <field name="fee"/>
                <field name="profit" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="asset_id" optional="hide"/>
                <field name="liquid" optional="hide"/>
                <field name="category_id" optional="hide"/>
                <field name="ttype" optional="hide"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="asset_transaction_graph">
        <field name="name">investment.asset.transaction.graph</field>
        <field name="model">investment.asset.transaction</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="payment_or_refund" type="measure"/>
            </graph>
        </field>
   </record>

    <record model="ir.ui.view" id="asset_transaction_form">
        <field name="name">investment.asset.transaction.form</field>
        <field name="model">investment.asset.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="time"/>
                            <field name="quantity"/>
                            <field name="cash_flow"/>
                            <field name="exchange_rate"/>
                            <field name="fee"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="not context.get('show_all')"/>
                            <field name="asset_id" invisible="not context.get('show_all')"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_transaction_search" model="ir.ui.view">
        <field name="name">investment.asset.transaction.search</field>
        <field name="model">investment.asset.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <separator/>
                <filter name="date_filter" date="time"/>
                <separator/>
                <separator/>
                <filter string="Long" name="long" domain="[('quantity', '>', 0.0)]"/>
                <filter string="Short" name="short" domain="[('quantity', '&lt;', 0.0)]"/>
                <filter string="Closed" name="closed" domain="[('quantity', '=', 0.0)]"/>
                <separator/>
                <filter string="Buy" name="buy" domain="[('ttype', '=', 'buy')]"/>
                <filter string="Sell" name="sell" domain="[('ttype', '=', 'sell')]"/>
                <filter string="Cost" name="cost" domain="[('ttype', '=', 'cost')]"/>
                <filter string="Yield" name="yield" domain="[('ttype', '=', 'yield')]"/>
                <separator/>
                <filter string="Liquid Assets" name="liquid" domain="[('liquid', '=', True)]"/>
                <filter string="Illiquid Assets" name="illiquid" domain="[('liquid', '=', False)]"/>
                <separator/>
                <filter string="Realized" name="realized" domain="[('prediction', '=', False)]" />
                <filter string="Prediction" name="prediction" domain="[('prediction', '=', True)]" />
                <separator />
                <filter string="1 year" name="1_year" domain="[('time','&gt;',(context_today() + relativedelta(days=-365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=365)).strftime('%Y-%m-%d'))]" />
                <filter string="2 years" name="2_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-2*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=2*365)).strftime('%Y-%m-%d'))]" />
                <filter string="3 years" name="3_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-3*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=3*365)).strftime('%Y-%m-%d'))]" />
                <filter string="4 years" name="4_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-4*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=4*365)).strftime('%Y-%m-%d'))]" />
                <filter string="5 years" name="5_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-5*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=5*365)).strftime('%Y-%m-%d'))]" />
                <filter string="6 years" name="6_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-6*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=6*365)).strftime('%Y-%m-%d'))]" />
                <filter string="7 years" name="7_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-7*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=7*365)).strftime('%Y-%m-%d'))]" />
                <filter string="8 years" name="8_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-8*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=8*365)).strftime('%Y-%m-%d'))]" />
                <filter string="9 years" name="9_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-9*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=9*365)).strftime('%Y-%m-%d'))]" />
                <filter string="10 years" name="10_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-10*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=10*365)).strftime('%Y-%m-%d'))]" />
                <group expand="1" string="Group by">
                    <filter string="Date" name="group_month" context="{'group_by': 'time:month'}" invisible="not context.get('search_default_group_month')"/>
                    <filter string="Date" name="group_year" context="{'group_by': 'time:year'}" invisible="not context.get('search_default_group_year')"/>
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}"/>
                    <filter string="Type" name="group_ttype" context="{'group_by': 'ttype'}"/>
                    <filter string="Asset" name="group_asset_id" context="{'group_by': 'asset_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_fill_daily_price" model="ir.actions.server">
        <field name="name">Fill daily price</field>
        <field name="model_id" ref="model_investment_asset_transaction"/>
        <field name="binding_model_id" ref="model_investment_asset_transaction"/>
        <field name="state">code</field>
        <field name="code">records._fill_daily_price()</field>
    </record>

    <record model="ir.actions.act_window" id="action_transactions_per_month">
        <field name="name">Transactions per month</field>
        <field name="res_model">investment.asset.transaction</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="context">{'search_default_group_month': 1, 'search_default_group_asset_id': 1, 'search_default_liquid': 1, 'search_default_1_year': 1, 'search_default_realized': 1}</field>
    </record>

    <record model="ir.actions.act_window" id="action_yearly_savings">
        <field name="name">Yearly savings</field>
        <field name="res_model">investment.asset.transaction</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="context">{'search_default_liquid': 1, 'search_default_group_year': 1, 'search_default_realized': 1}</field>
    </record>


</odoo>