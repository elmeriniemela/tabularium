<odoo>
    <record id="total_timeseries_tree" model="ir.ui.view">
        <field name="name">investment.total.timeseries.list</field>
        <field name="model">investment.total.timeseries</field>
        <field name="arch" type="xml">
            <list>
                <field name="time" optional="show"/>
                <field name="tstype" optional="show"/>
                <field name="position" optional="show" sum="Total Position"/>
            </list>
        </field>
    </record>

    <record id="total_timeseries_position" model="ir.ui.view">
        <field name="name">investment.total.timeseries.graph</field>
        <field name="model">investment.total.timeseries</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="position" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="total_timeseries_position_chart" model="ir.ui.view">
        <field name="name">investment.total.timeseries.chart</field>
        <field name="model">investment.total.timeseries</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <chart>
                <field name="time" type="time"/>
                <field name="position" type="candlestick"/>
            </chart>
        </field>
    </record>

    <record id="total_timeseries_form" model="ir.ui.view">
        <field name="name">investment.total.timeseries.form</field>
        <field name="model">investment.total.timeseries</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="time"/>
                            <field name="position"/>
                            <field name="tstype"/>
                        </group>
                    </group>
                    <field name="timeseries_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="total_timeseries_search" model="ir.ui.view">
        <field name="name">investment.total.timeseries.search</field>
        <field name="model">investment.total.timeseries</field>
        <field name="arch" type="xml">
            <search>
                <field name="time"/>
                <separator/>
                <filter name="time_filter" date="time"/>
                <separator/>
                <filter string="Until Today" name="until_today" domain="[('time', '&lt;=', 'now')]"/>
                <separator/>
                <filter string="1 Year" name="1_year" domain="[('time', '&gt;', 'today -365d'), ('time', '&lt;', 'today +365d')]"/>
                <filter string="2 Years" name="2_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-2*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=2*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="3 Years" name="3_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-3*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=3*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="4 Years" name="4_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-4*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=4*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="5 Years" name="5_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-5*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=5*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="6 Years" name="6_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-6*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=6*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="7 Years" name="7_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-7*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=7*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="8 Years" name="8_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-8*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=8*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="9 Years" name="9_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-9*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=9*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="10 Years" name="10_years" domain="[('time','&gt;',(context_today() + relativedelta(days=-10*365)).strftime('%Y-%m-%d')),('time','&lt;',(context_today() + relativedelta(days=10*365)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter string="Time" name="group_day" context="{'group_by': 'time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_total_positions" model="ir.actions.act_window">
        <field name="name">Total positions</field>
        <field name="res_model">investment.total.timeseries</field>
        <field name="view_mode">chart,list,form,pivot</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_1_year': 1, 'search_default_until_today': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'chart', 'view_id': ref('total_timeseries_position_chart')}),
            ]"
        />
    </record>

    <record id="action_totals_view_timeseries" model="ir.actions.server">
        <field name="name">Show timeseries</field>
        <field name="model_id" ref="model_investment_total_timeseries"/>
        <field name="binding_model_id" ref="model_investment_total_timeseries"/>
        <field name="group_ids" eval="[(4, ref('group_investment_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_view_timeseries()</field>
    </record>

</odoo>
