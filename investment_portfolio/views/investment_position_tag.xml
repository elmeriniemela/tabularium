<odoo>
    <record id="position_tag_tree" model="ir.ui.view">
        <field name="name">investment.position.tag.list</field>
        <field name="model">investment.position.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="position_tag_form" model="ir.ui.view">
        <field name="name">investment.position.tag.form</field>
        <field name="model">investment.position.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="position_tag_search" model="ir.ui.view">
        <field name="name">investment.position.tag.search</field>
        <field name="model">investment.position.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_position_tags" model="ir.actions.act_window">
        <field name="name">Position Tags</field>
        <field name="res_model">investment.position.tag</field>
        <field name="view_mode">list,form</field>

    </record>
</odoo>