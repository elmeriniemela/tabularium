<odoo>
    <record id="category_tree" model="ir.ui.view">
        <field name="name">investment.category.list</field>
        <field name="model">investment.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="liquid" optional="show" widget="boolean_toggle"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="category_form" model="ir.ui.view">
        <field name="name">investment.category.form</field>
        <field name="model">investment.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="liquid"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="category_search" model="ir.ui.view">
        <field name="name">investment.category.search</field>
        <field name="model">investment.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_create_date" date="create_date"/>
                <separator/>
                <filter string="Liquid" name="filter_liquid" domain="[('liquid', '=', True)]"/>
                <filter string="Illiquid" name="filter_illiquid" domain="[('liquid', '=', False)]"/>
                <group>
                    <filter string="Liquid" name="group_liquid" context="{'group_by': 'liquid'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">investment.category</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'search_default_group_category_id': 1}</field>
    </record>

</odoo>