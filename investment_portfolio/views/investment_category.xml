<odoo>
    <record id="portfolio_tree" model="ir.ui.view">
        <field name="name">investment.portfolio.tree</field>
        <field name="model">investment.portfolio</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="portfolio_form" model="ir.ui.view">
        <field name="name">investment.portfolio.form</field>
        <field name="model">investment.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portfolio_search" model="ir.ui.view">
        <field name="name">investment.portfolio.search</field>
        <field name="model">investment.portfolio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_portfolios" model="ir.actions.act_window">
        <field name="name">Portfolios</field>
        <field name="res_model">investment.portfolio</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{'search_default_group_portfolio_id': 1}</field>
    </record>

</odoo>