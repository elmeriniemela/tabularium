<odoo>
    <record id="asset_tree" model="ir.ui.view">
        <field name="name">investment.asset.tree</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="ticker"/>
                <field name="last_price_currency" optional="show"/>
                <field name="last_update" optional="show" widget="timeago"/>
                <field name="daily_price" widget="percentage" decoration-danger="daily_price &lt; 0" decoration-success="daily_price &gt; 0" optional="show"/>
                <field name="weekly_price" widget="percentage" decoration-danger="weekly_price &lt; 0" decoration-success="weekly_price &gt; 0" optional="show"/>
                <field name="monthly_price" widget="percentage" decoration-danger="monthly_price &lt; 0" decoration-success="monthly_price &gt; 0" optional="show"/>
                <field name="three_month_price" widget="percentage" decoration-danger="three_month_price &lt; 0" decoration-success="three_month_price &gt; 0" optional="show"/>
                <field name="six_month_price" widget="percentage" decoration-danger="six_month_price &lt; 0" decoration-success="six_month_price &gt; 0" optional="show"/>
                <field name="ytd_price" widget="percentage" decoration-danger="ytd_price &lt; 0" decoration-success="ytd_price &gt; 0" optional="show"/>
                <field name="one_year_price" widget="percentage" decoration-danger="one_year_price &lt; 0" decoration-success="one_year_price &gt; 0" optional="show"/>
                <field name="three_year_price" widget="percentage" decoration-danger="three_year_price &lt; 0" decoration-success="three_year_price &gt; 0" optional="show"/>
                <field name="five_year_price" widget="percentage" decoration-danger="five_year_price &lt; 0" decoration-success="five_year_price &gt; 0" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="endpoint_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="asset_form" model="ir.ui.view">
        <field name="name">investment.asset.form</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="run_integration" type="object" string="Run Integration" icon="fa-cogs"/>
                    <button name="%(action_prices)d"
                        string="Prices"
                        type="action"
                        context="{'search_default_asset_id': id, 'search_default_realized': 1, 'search_default_group_time': 1}"
                        class="oe_stat_button"
                        icon="fa-usd">
                    </button>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ticker"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="currency_id"/>
                            <field name="category_id"/>
                            <field name="endpoint_id"/>
                            <field name="daily_price" widget="percentage" decoration-danger="daily_price &lt; 0" decoration-success="daily_price &gt; 0"/>
                            <field name="weekly_price" widget="percentage" decoration-danger="weekly_price &lt; 0" decoration-success="weekly_price &gt; 0"/>
                            <field name="monthly_price" widget="percentage" decoration-danger="monthly_price &lt; 0" decoration-success="monthly_price &gt; 0"/>
                        </group>
                        <group>
                            <label for="last_price_currency"/>
                            <div>
                                <field name="last_price_currency" class="oe_inline"/>
                                <span> (<field name="last_update" widget="timeago" class="oe_inline"/>) </span>
                            </div>
                            <field name="three_month_price" widget="percentage" decoration-danger="three_month_price &lt; 0" decoration-success="three_month_price &gt; 0"/>
                            <field name="six_month_price" widget="percentage" decoration-danger="six_month_price &lt; 0" decoration-success="six_month_price &gt; 0"/>
                            <field name="ytd_price" widget="percentage" decoration-danger="ytd_price &lt; 0" decoration-success="ytd_price &gt; 0"/>
                            <field name="one_year_price" widget="percentage" decoration-danger="one_year_price &lt; 0" decoration-success="one_year_price &gt; 0"/>
                            <field name="three_year_price" widget="percentage" decoration-danger="three_year_price &lt; 0" decoration-success="three_year_price &gt; 0"/>
                            <field name="five_year_price" widget="percentage" decoration-danger="five_year_price &lt; 0" decoration-success="five_year_price &gt; 0"/>
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="asset_search" model="ir.ui.view">
        <field name="name">investment.asset.search</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="ticker"/>
                <field name="category_id"/>
                <separator/>
                <group expand="1" string="Group by">
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}"/>
                    <filter string="Ticker" name="group_ticker" context="{'group_by': 'ticker'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_assets" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">investment.asset</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

</odoo>