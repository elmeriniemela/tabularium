<odoo>
    <record model="ir.ui.view" id="asset_tree">
        <field name="name">investment.asset.tree</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="ticker" optional="show"/>
                <field name="quantity" optional="show"/>
                <field name="value" optional="show" sum="Total"/>
                <field name="profit" widget="monetary" options="{'is_profit': 1}" optional="show"/>
                <field name="profit_percent" widget="percentage" options="{'is_profit': 1}" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="integration_id" optional="hide"/>
                <field name="company_currency_id" invisible="1"/>

                <field name="buy_total" optional="hide" />
                <field name="avg_buy_price" optional="hide"/>
                <field name="sell_total" optional="hide"/>
                <field name="avg_sell_price" optional="hide"/>
                <field name="last_price" optional="hide"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="asset_graph">
         <field name="name">investment.asset.graph</field>
         <field name="model">investment.asset</field>
         <field name="arch" type="xml">
             <graph type="line">
                 <field name="value" type="measure"/>
             </graph>
         </field>
    </record>

    <record model="ir.ui.view" id="asset_form">
        <field name="name">investment.asset.form</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="run_integration" type="object" string="Run Integration"/>
                </header>
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticker"/>
                            <field name="company_id"/>
                            <field name="company_currency_id"/>
                            <field name="currency_id"/>
                            <field name="value"/>
                            <field name="profit" options="{'is_profit': 1}"/>
                            <field name="profit_percent" widget="percentage" options="{'is_profit': 1}"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="integration_id"/>
                            <field name="quantity"/>
                            <field name="buy_total" />
                            <field name="avg_buy_price" />
                            <field name="sell_total" attrs="{'invisible': [('sell_total', '=', 0.0)]}"/>
                            <field name="avg_sell_price" attrs="{'invisible': [('sell_total', '=', 0.0)]}"/>
                            <field name="last_price"/>
                        </group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Prices">
                            <field name="price_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Transactions">
                            <field name="transaction_ids" context="{'default_asset_id': id}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="asset_search" model="ir.ui.view">
        <field name="name">investment.asset.search</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group expand="1" string="Group by">
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}"/>
                    <filter string="Name" name="group_name" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_recompute_value" model="ir.actions.server">
        <field name="name">Re-compute Value</field>
        <field name="model_id" ref="model_investment_asset"/>
        <field name="binding_model_id" ref="model_investment_asset"/>
        <field name="state">code</field>
        <field name="code">records.recompute_value()</field>
    </record>

    <record model="ir.actions.act_window" id="asset_action_window">
        <field name="name">Assets</field>
        <field name="res_model">investment.asset</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{'search_default_group_category_id': 1}</field>
    </record>

    <menuitem name="Investment Portfolio" id="root_menu" web_icon="investment_portfolio,static/description/icon.png"/>
    <menuitem id="asset_menu" action="asset_action_window" parent="root_menu" sequence="1"/>
    <menuitem id="currency_menu" action="base.action_currency_form" parent="root_menu" sequence="100"/>

</odoo>