<odoo>
    <record model="ir.ui.view" id="asset_tree">
        <field name="name">investment.asset.tree</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <tree expand="1">
                <field name="name" optional="show"/>
                <field name="ticker" optional="show"/>
                <field name="last_update" optional="show" widget="timeago"/>
                <field name="position" optional="show" sum="Total Position"/>
                <field name="quantity" optional="show"/>
                <field name="last_price" optional="show"/>
                <field name="daily_price" widget="percentage" options="{'is_profit': 1}" optional="show"/>
                <field name="weekly_price" widget="percentage" options="{'is_profit': 1}" optional="show"/>
                <field name="monthly_price" widget="percentage" options="{'is_profit': 1}" optional="show"/>
                <field name="ytd_price" widget="percentage" options="{'is_profit': 1}"/>
                <field name="profit" widget="monetary" options="{'is_profit': 1}" optional="show" sum="Total Profit"/>
                <field name="profit_percent" widget="percentage" options="{'is_profit': 1}" optional="show"/>

                <field name="currency_id" optional="hide"/>
                <field name="integration_id" optional="hide"/>
                <field name="company_currency_id" optional="hide"/>
                <field name="buy_total" optional="hide" />
                <field name="avg_buy_price" optional="hide"/>
                <field name="sell_total" optional="hide" sum="Total"/>
                <field name="avg_sell_price" optional="hide"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="asset_pie_graph">
         <field name="name">investment.asset.graph</field>
         <field name="model">investment.asset</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
             <graph type="pie">
                 <field name="position" type="measure"/>
             </graph>
         </field>
    </record>

    <record model="ir.ui.view" id="asset_bar_graph">
        <field name="name">investment.asset.graph</field>
        <field name="model">investment.asset</field>
        <field name="priority" eval="2" />
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="position" type="measure"/>
            </graph>
        </field>
   </record>

    <record model="ir.ui.view" id="asset_form">
        <field name="name">investment.asset.form</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="run_integration" type="object" string="Run Integration"/>
                </header>
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticker"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="category_id"/>
                            <field name="integration_id"/>
                            <field name="ytd_price" widget="percentage" options="{'is_profit': 1}"/>
                            <field name="monthly_price" widget="percentage" options="{'is_profit': 1}"/>
                            <field name="weekly_price" widget="percentage" options="{'is_profit': 1}"/>
                            <field name="daily_price" widget="percentage" options="{'is_profit': 1}"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="last_update" widget="timeago"/>
                            <field name="company_currency_id"/>
                            <field name="position"/>
                            <field name="last_price"/>
                            <field name="avg_buy_price" />
                            <field name="sell_total"  attrs="{'invisible': [('quantity', '!=', 0.0)]}"/>
                            <field name="buy_total"/>
                            <field name="avg_sell_price" attrs="{'invisible': [('quantity', '!=', 0.0)]}"/>
                            <field name="profit" options="{'is_profit': 1}"/>
                            <field name="profit_percent" widget="percentage" options="{'is_profit': 1}"/>
                        </group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Prices">
                            <field name="price_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Expectations">
                            <field name="expectation_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Thesis">
                            <field name="thesis"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="asset_search" model="ir.ui.view">
        <field name="name">investment.asset.search</field>
        <field name="model">investment.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter string="Long" name="long" domain="[('quantity', '>', 0.0)]"/>
                <filter string="Short" name="short" domain="[('quantity', '&lt;', 0.0)]"/>
                <filter string="Closed" name="closed" domain="[('quantity', '=', 0.0)]"/>
                <separator/>
                <filter string="Liquid" name="liquid" domain="[('liquid', '=', True)]"/>
                <filter string="Illiquid" name="illiquid" domain="[('liquid', '=', False)]"/>
                <separator/>
                <group expand="1" string="Group by">
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}"/>
                    <filter string="Name" name="group_name" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_compute_aggregate" model="ir.actions.server">
        <field name="name">Re-compute Value</field>
        <field name="model_id" ref="model_investment_asset"/>
        <field name="binding_model_id" ref="model_investment_asset"/>
        <field name="state">code</field>
        <field name="code">records._compute_aggregate()</field>
    </record>

    <record model="ir.actions.act_window" id="action_current_positions">
        <field name="name">Current positions</field>
        <field name="res_model">investment.asset</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{'search_default_group_category_id': 1, 'search_default_long': 1, 'search_default_liquid': 1,}</field>
    </record>

    <record model="ir.actions.act_window" id="action_liquid_allocations">
        <field name="name">Liquid Allocations</field>
        <field name="res_model">investment.asset</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="context">{'search_default_group_name': 1, 'search_default_long': 1, 'search_default_liquid': 1,}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
            ]"
        />
    </record>

    <record model="ir.actions.act_window" id="action_allocations_by_asset_class">
        <field name="name">Allocations by asset class</field>
        <field name="res_model">investment.asset</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="context">{'search_default_group_category_id': 1, 'search_default_group_name': 1,}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('asset_bar_graph')}),
            ]"
        />
    </record>

</odoo>