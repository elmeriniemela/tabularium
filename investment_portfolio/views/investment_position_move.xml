<odoo>
    <record id="position_move_tree" model="ir.ui.view">
        <field name="name">investment.position.move.tree</field>
        <field name="model">investment.position.move</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="position_id"/>
                <field name="time"/>
            </tree>
        </field>
    </record>

    <record id="position_move_form" model="ir.ui.view">
        <field name="name">investment.position.move.form</field>
        <field name="model">investment.position.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="position_id"/>
                        </group>
                        <group>
                            <field name="time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" context="{'default_position_id': position_id, 'default_move_id': id, 'default_time': time}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>


    <record id="position_move_search" model="ir.ui.view">
        <field name="name">investment.position.move.search</field>
        <field name="model">investment.position.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="position_id"/>
                <separator/>
                <filter name="date_filter" date="time"/>
                <separator/>
                <group expand="1" string="Group by">
                    <filter string="Position" name="group_position_id" context="{'group_by': 'position_id'}"/>
                    <filter string="Date" name="group_month" context="{'group_by': 'time:month'}" invisible="not context.get('search_default_group_month')"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_position_moves" model="ir.actions.act_window">
        <field name="name">Moves</field>
        <field name="res_model">investment.position.move</field>
        <field name="view_mode">tree,form</field>

    </record>
</odoo>