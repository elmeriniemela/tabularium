<odoo>
    <record id="position_move_tree" model="ir.ui.view">
        <field name="name">investment.position.move.list</field>
        <field name="model">investment.position.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="time"/>
                <field name="position_ids" widget="many2many_tags"/>
                <field name="profit" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0"/>
                <field name="cash_flow" decoration-danger="cash_flow &lt; 0" decoration-success="cash_flow &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="position_move_form" model="ir.ui.view">
        <field name="name">investment.position.move.form</field>
        <field name="model">investment.position.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="profit" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0"/>
                        </group>
                        <group>
                            <field name="time"/>
                            <field name="cash_flow" decoration-danger="cash_flow &lt; 0" decoration-success="cash_flow &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" widget="many2many" context="{'default_move_id': id, 'default_time': time, 'search_default_record': 1, 'search_default_move_not_set': 1}"/>
                        </page>
                        <page string="Notes">
                            <field name="note_id"/>
                            <field name="note" invisible="not note_id"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="position_move_search" model="ir.ui.view">
        <field name="name">investment.position.move.search</field>
        <field name="model">investment.position.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="position_ids"/>
                <field name="name"/>
                <separator/>
                <filter name="date_filter" date="time"/>
                <separator/>
                <group expand="1" string="Group by">
                    <filter string="Date" name="group_month" context="{'group_by': 'time:month'}" invisible="not context.get('search_default_group_month')"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_position_moves" model="ir.actions.act_window">
        <field name="name">Moves</field>
        <field name="res_model">investment.position.move</field>
        <field name="view_mode">list,form</field>

    </record>
</odoo>