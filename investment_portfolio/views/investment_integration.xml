<odoo>
    <record id="integration_tree" model="ir.ui.view">
        <field name="name">investment.integration.tree</field>
        <field name="model">investment.integration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="integration_form" model="ir.ui.view">
        <field name="name">investment.integration.form</field>
        <field name="model">investment.integration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="code" widget="ace" options="{'mode': 'python'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="integration_search" model="ir.ui.view">
        <field name="name">investment.integration.search</field>
        <field name="model">investment.integration</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_integrations" model="ir.actions.act_window">
        <field name="name">Integrations</field>
        <field name="res_model">investment.integration</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>