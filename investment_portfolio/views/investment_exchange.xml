<odoo>
    <record id="exchange_tree" model="ir.ui.view">
        <field name="name">investment.exchange.list</field>
        <field name="model">investment.exchange</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="is_open" optional="show"/>
                <field name="is_recently_open" optional="show"/>
                <field name="opening_time" options="{'type': 'time'}" widget="float_time" optional="show"/>
                <field name="closing_time" options="{'type': 'time'}" widget="float_time" optional="show"/>
                <field name="tz" optional="show"/>
                <field name="weekend_trading" optional="show"/>
                <field name="next_open" optional="show"/>
                <field name="next_close" optional="show"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="exchange_form" model="ir.ui.view">
        <field name="name">investment.exchange.form</field>
        <field name="model">investment.exchange</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="opening_time" string="Open"/>
                            <div class="o_row">
                                <field name="opening_time" options="{'type': 'time'}" widget="float_time"/>
                                <i class="fa fa-long-arrow-right mx-1" title="Arrow"/>
                                <field name="closing_time" options="{'type': 'time'}" widget="float_time"/>
                            </div>
                            <field name="next_open"/>
                            <field name="next_close"/>

                        </group>
                        <group>
                            <field name="tz"/>
                            <field name="weekend_trading"/>
                            <field name="is_open"/>
                            <field name="is_recently_open"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Gaps">
                            <field name="gap_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="exchange_search" model="ir.ui.view">
        <field name="name">investment.exchange.search</field>
        <field name="model">investment.exchange</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tz"/>
                <separator/>
                <filter string="Weekend Trading" name="filter_weekend_trading" domain="[('weekend_trading', '=', True)]"/>
                <filter string="No Weekend Trading" name="filter_no_weekend_trading" domain="[('weekend_trading', '=', False)]"/>
                <group>
                    <filter string="Timezone" name="group_tz" context="{'group_by': 'tz'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_exchange" model="ir.actions.act_window">
        <field name="name">Exchanges</field>
        <field name="res_model">investment.exchange</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'search_default_group_exchange_id': 1}</field>
    </record>

</odoo>