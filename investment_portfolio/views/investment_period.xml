<odoo>
    <record id="period_tree" model="ir.ui.view">
        <field name="name">investment.period.list</field>
        <field name="model">investment.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" widget="priority"  nolabel="1" width="20px" optional="show"/>
                <field name="name"/>
                <field name="start_position" optional="show"/>
                <field name="end_position" optional="show"/>
                <field name="profit" widget="monetary" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0"/>
                <field name="annualized_irr" widget="percentage" decoration-danger="annualized_irr &lt; 0" decoration-success="annualized_irr &gt; 0"/>
                <field name="start_date" optional="hide"/>
                <field name="end_date" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="company_currency_id" optional="hide"/>
                <button title="Update" icon="fa-refresh" name="action_compute" type="object"/>
            </list>
        </field>
    </record>

    <record id="period_form" model="ir.ui.view">
        <field name="name">investment.period.form</field>
        <field name="model">investment.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-tasks" name="action_view_positions">
                            <field name="count_positions" widget="statinfo" string="Positions"/>
                        </button>
                        <button class="oe_stat_button" type="object" icon="fa-tasks" name="action_view_timeseries">
                            <field name="count_timeseries" widget="statinfo" string="Timeseries"/>
                        </button>
                        <button class="oe_stat_button" type="object" icon="fa-tasks" name="action_view_transactions">
                            <field name="count_transactions" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <div class="oe_title pe-0">
                        <h1 class="d-flex justify-content-between align-items-center">
                            <div class="d-flex w-100">
                                <field name="priority" widget="priority" class="me-3"/>
                                <field name="name" options="{'line_breaks': False}" widget="text" lass="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="To-do..."/>
                            </div>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Performance">
                            <group>
                                <group>
                                    <field name="start_position"/>
                                    <field name="end_position"/>
                                </group>
                                <group>
                                    <field name="profit" widget="monetary" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0"/>
                                    <field name="annualized_irr" widget="percentage" decoration-danger="annualized_irr &lt; 0" decoration-success="annualized_irr &gt; 0"/>
                                </group>
                            </group>
                        </page>
                        <page string="Settings">
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="company_id"/>
                                <field name="company_currency_id" invisible="1"/>
                                <field name="domain" widget="domain" options="{'model': 'investment.position'}"/>
                                <field name="debug_xirr"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="period_search" model="ir.ui.view">
        <field name="name">investment.period.search</field>
        <field name="model">investment.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>


    <record id="action_periods" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">investment.period</field>
        <field name="view_mode">list,form,graph</field>
    </record>

</odoo>