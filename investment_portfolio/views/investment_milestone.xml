<odoo>
    <record model="ir.ui.view" id="milestone_tree">
        <field name="name">investment.milestone.tree</field>
        <field name="model">investment.milestone</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'ahead'" decoration-muted="state == 'behind'" decoration-danger="state == 'missed'" decoration-success="state == 'reached'">
                <field name="name"/>
                <field name="date"/>
                <field name="position"/>
                <field name="predicted_position"/>
                <field name="difference"/>
                <field name="inflation_rate" widget="percentage"/>
                <field name="real_position"/>
                <field name="state"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="milestone_form">
        <field name="name">investment.milestone.form</field>
        <field name="model">investment.milestone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="date"/>
                        <field name="position"/>
                        <field name="predicted_position"/>
                        <field name="difference"/>
                        <field name="inflation_rate" widget="percentage"/>
                        <field name="real_position"/>
                        <field name="company_id"/>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="domain" widget="domain" options="{'model': 'investment.asset'}"/>
                        <field name="state"/>
                    </group>
                    <field name="timeseries_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="milestone_search" model="ir.ui.view">
        <field name="name">investment.milestone.search</field>
        <field name="model">investment.milestone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="position"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="action_milestones">
        <field name="name">Milestones</field>
        <field name="res_model">investment.milestone</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

</odoo>