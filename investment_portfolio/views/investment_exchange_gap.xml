<odoo>
    <record id="exchange_gap_tree" model="ir.ui.view">
        <field name="name">investment.exchange.gap.list</field>
        <field name="model">investment.exchange.gap</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="date"/>
                <field name="closing_time" options="{'type': 'time'}" widget="float_time"/>
                <field name="closing_datetime" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="exchange_gap_form" model="ir.ui.view">
        <field name="name">investment.exchange.gap.form</field>
        <field name="model">investment.exchange.gap</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="closing_time" options="{'type': 'time'}" widget="float_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="exchange_gap_search" model="ir.ui.view">
        <field name="name">investment.exchange.gap.search</field>
        <field name="model">investment.exchange.gap</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

</odoo>