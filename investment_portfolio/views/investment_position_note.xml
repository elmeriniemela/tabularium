<odoo>
    <record id="position_note_tree" model="ir.ui.view">
        <field name="name">investment.position.note.list</field>
        <field name="model">investment.position.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="position_ids" widget="many2many_tags"/>
                <field name="move_ids" widget="many2many_tags"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="position_note_form" model="ir.ui.view">
        <field name="name">investment.position.note.form</field>
        <field name="model">investment.position.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" icon="fa-tasks" name="%(version_control.version_control_action)d" context="{'search_default_model': 'investment.position.note', 'search_default_res_id': id}">
                            <field name="version_control_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="content"/>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="position_note_search" model="ir.ui.view">
        <field name="name">investment.position.note.search</field>
        <field name="model">investment.position.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="position_ids" widget="many2many_tags"/>
                <field name="move_ids" widget="many2many_tags"/>
            </search>
        </field>
    </record>


    <record id="action_position_notes" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">investment.position.note</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>