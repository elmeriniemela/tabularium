<odoo>
    <record model="ir.ui.view" id="date_tree">
        <field name="name">investment.date.tree</field>
        <field name="model">investment.date</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date" optional="show"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="date_form">
        <field name="name">investment.date.form</field>
        <field name="model">investment.date</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <h1>
                            <field name="date"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="date_search" model="ir.ui.view">
        <field name="name">investment.date.search</field>
        <field name="model">investment.date</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="date_action_window">
        <field name="name">Dates</field>
        <field name="res_model">investment.date</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{'search_default_group_date_id': 1}</field>
    </record>

    <menuitem id="date_menu" action="date_action_window" parent="root_menu" sequence="1"/>

</odoo>