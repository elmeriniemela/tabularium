<odoo>
    <record id="timeseries_tree" model="ir.ui.view">
        <field name="name">investment.timeseries.list</field>
        <field name="model">investment.timeseries</field>
        <field name="arch" type="xml">
            <list>
                <field name="position_id" optional="show"/>
                <field name="prediction" optional="show"/>
                <field name="interpolated" optional="show"/>
                <field name="date" optional="show"/>
                <field name="position" optional="show" sum="Total Position"/>
                <field name="profit" widget="monetary" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0" optional="show" sum="Total Profit"/>
                <field name="profit_percent" widget="percentage" decoration-danger="profit_percent &lt; 0" decoration-success="profit_percent &gt; 0" optional="show"/>
                <field name="company_currency_id" invisible="1"/>

                <field name="last_price_own_currency" optional="hide"/>
                <field name="quantity" optional="hide"/>
                <field name="open_position" optional="hide"/>
                <field name="open_profit" optional="hide"/>
                <field name="high_position" optional="hide"/>
                <field name="high_profit" optional="hide"/>
                <field name="low_position" optional="hide"/>
                <field name="low_profit" optional="hide"/>
                <field name="price_id" optional="hide"/>
                <field name="open_price_id" optional="hide"/>
                <field name="high_price_id" optional="hide"/>
                <field name="low_price_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="category_id" optional="hide"/>
                <field name="portfolio_id" optional="hide"/>
                <field name="liquid" optional="hide"/>
                <field name="granularity" optional="hide"/>
                <field name="is_sunday" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="timeseries_profit" model="ir.ui.view">
        <field name="name">investment.timeseries.graph</field>
        <field name="model">investment.timeseries</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="timeseries_position" model="ir.ui.view">
        <field name="name">investment.timeseries.graph</field>
        <field name="model">investment.timeseries</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="position" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="timeseries_position_chart" model="ir.ui.view">
        <field name="name">investment.timeseries.chart</field>
        <field name="model">investment.timeseries</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <chart>
                <field name="date" type="time"/>
                <field name="position" type="candlestick"/>
            </chart>
        </field>
    </record>

    <record id="timeseries_form" model="ir.ui.view">
        <field name="name">investment.timeseries.form</field>
        <field name="model">investment.timeseries</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="position_id"/>
                            <field name="date"/>
                            <field name="granularity"/>
                            <field name="is_sunday"/>
                            <field name="price_id"/>
                            <field name="open_price_id"/>
                            <field name="high_price_id"/>
                            <field name="low_price_id"/>
                            <field name="company_currency_id"/>
                            <field name="position"/>
                            <field name="open_position"/>
                            <field name="high_position"/>
                            <field name="low_position"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="quantity"/>
                            <field name="last_price_own_currency"/>
                            <field name="profit_percent" widget="percentage" decoration-danger="profit_percent &lt; 0" decoration-success="profit_percent &gt; 0"/>
                            <field name="profit" decoration-danger="profit &lt; 0" decoration-success="profit &gt; 0"/>
                            <field name="open_profit" decoration-danger="open_profit &lt; 0" decoration-success="open_profit &gt; 0"/>
                            <field name="high_profit" decoration-danger="high_profit &lt; 0" decoration-success="high_profit &gt; 0"/>
                            <field name="low_profit" decoration-danger="low_profit &lt; 0" decoration-success="low_profit &gt; 0"/>
                            <field name="prediction"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" context="{'default_position_id': id}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="timeseries_search" model="ir.ui.view">
        <field name="name">investment.timeseries.search</field>
        <field name="model">investment.timeseries</field>
        <field name="arch" type="xml">
            <search>
                <field name="position_id"/>
                <field name="category_id"/>
                <field name="portfolio_id"/>
                <field name="company_id"/>
                <field name="price_id"/>
                <separator/>
                <filter string="Long" name="long" domain="[('quantity', '>', 0.0)]"/>
                <filter string="Short" name="short" domain="[('quantity', '&lt;', 0.0)]"/>
                <filter string="Closed" name="closed" domain="[('quantity', '=', 0.0)]"/>
                <separator/>
                <filter name="date_filter" date="date"/>
                <filter name="filter_create_date" date="create_date"/>
                <separator/>
                <filter string="Liquid Assets" name="liquid" domain="[('liquid', '=', True)]"/>
                <filter string="Illiquid Assets" name="illiquid" domain="[('liquid', '=', False)]"/>
                <separator/>
                <filter string="Realized" name="realized" domain="[('prediction', '=', False)]"/>
                <filter string="Prediction" name="prediction" domain="[('prediction', '=', True)]"/>
                <separator/>
                <filter string="Interpolated" name="filter_interpolated" domain="[('interpolated', '=', True)]"/>
                <filter string="Not Interpolated" name="filter_not_interpolated" domain="[('interpolated', '=', False)]"/>
                <separator/>
                <filter string="Sunday" name="filter_is_sunday" domain="[('is_sunday', '=', True)]"/>
                <filter string="Not Sunday" name="filter_not_sunday" domain="[('is_sunday', '=', False)]"/>
                <separator/>
                <filter string="Until Today" name="until_today" domain="[('date', '&lt;=', 'now')]"/>
                <separator/>
                <filter string="1 Year" name="1_year" domain="[('date', '&gt;', 'today -365d'), ('date', '&lt;', 'today +365d')]"/>
                <filter string="2 Years" name="2_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-2*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=2*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="3 Years" name="3_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-3*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=3*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="4 Years" name="4_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-4*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=4*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="5 Years" name="5_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-5*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=5*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="6 Years" name="6_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-6*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=6*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="7 Years" name="7_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-7*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=7*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="8 Years" name="8_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-8*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=8*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="9 Years" name="9_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-9*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=9*365)).strftime('%Y-%m-%d'))]"/>
                <filter string="10 Years" name="10_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-10*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=10*365)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Date (Day)" name="group_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Date (Week)" name="group_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Date (Month)" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Date (Year)" name="group_year" context="{'group_by': 'date:year'}"/>
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}"/>
                    <filter string="Portfolio" name="group_portfolio_id" context="{'group_by': 'portfolio_id'}"/>
                    <filter string="Position" name="group_position_id" context="{'group_by': 'position_id'}"/>
                    <filter string="Company" name="group_company_id" context="{'group_by': 'company_id'}"/>
                    <filter string="Granularity" name="group_granularity" context="{'group_by': 'granularity'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_compute_timeseries_aggregate" model="ir.actions.server">
        <field name="name">Re-compute Value</field>
        <field name="model_id" ref="model_investment_timeseries"/>
        <field name="binding_model_id" ref="model_investment_timeseries"/>
        <field name="state">code</field>
        <field name="code">records._compute_timeseries_aggregate()</field>
    </record>

    <record id="action_profits_per_asset" model="ir.actions.act_window">
        <field name="name">Profits per asset</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,list,form,pivot</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_group_week': 1, 'search_default_group_position_id': 1, 'search_default_liquid': 1, 'search_default_4_years': 1, 'search_default_until_today': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
            ]"
        />
    </record>

    <record id="action_positions_per_asset" model="ir.actions.act_window">
        <field name="name">Positions per asset</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,list,form,pivot</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_group_week': 1, 'search_default_group_position_id': 1, 'search_default_liquid': 1, 'search_default_4_years': 1, 'search_default_until_today': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('timeseries_position')}),
            ]"
        />
    </record>

    <record id="action_prediction_growth" model="ir.actions.act_window">
        <field name="name">Predicted growth</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,list,form,pivot</field>
        <field name="context">{'search_default_group_year': 1, 'search_default_group_position_id': 1, 'search_default_liquid': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('timeseries_position')}),
            ]"
        />
    </record>

</odoo>