<odoo>
    <record model="ir.ui.view" id="timeseries_tree">
        <field name="name">investment.timeseries.tree</field>
        <field name="model">investment.timeseries</field>
        <field name="arch" type="xml">
            <tree>
                <field name="asset_id" optional="show" />
                <field name="position" optional="show" sum="Total Position" />
                <field name="profit" widget="monetary" options="{'is_profit': 1}" optional="show" sum="Total Profit" />
                <field name="profit_percent" widget="percentage" options="{'is_profit': 1}" optional="show" />
                <field name="company_currency_id" invisible="1" />

                <field name="buy_total" optional="hide" />
                <field name="avg_buy_price" optional="hide" />
                <field name="sell_total" optional="hide" sum="Total" />
                <field name="avg_sell_price" optional="hide" />
                <field name="last_price" optional="hide" />
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="timeseries_profit">
        <field name="name">investment.timeseries.graph</field>
        <field name="model">investment.timeseries</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="profit" type="measure" />
            </graph>
        </field>
    </record>

    <record model="ir.ui.view" id="timeseries_position">
        <field name="name">investment.timeseries.graph</field>
        <field name="model">investment.timeseries</field>
        <field name="priority" eval="2" />
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="position" type="measure" />
            </graph>
        </field>
    </record>

    <record model="ir.ui.view" id="timeseries_form">
        <field name="name">investment.timeseries.form</field>
        <field name="model">investment.timeseries</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id" />
                            <field name="date" />
                            <field name="granularity" />
                            <field name="is_monday" />
                            <field name="price_id" />
                            <field name="company_currency_id" />
                            <field name="position" />
                            <field name="buy_total" />
                        </group>
                        <group>
                            <field name="category_id" />
                            <field name="quantity" />
                            <field name="last_price" />
                            <field name="avg_buy_price" />
                            <field name="sell_total" attrs="{'invisible': [('quantity', '!=', 0.0)]}" />
                            <field name="avg_sell_price" attrs="{'invisible': [('quantity', '!=', 0.0)]}" />
                            <field name="profit" options="{'is_profit': 1}" />
                            <field name="profit_percent" widget="percentage" options="{'is_profit': 1}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" context="{'default_asset_id': id}" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="timeseries_search" model="ir.ui.view">
        <field name="name">investment.timeseries.search</field>
        <field name="model">investment.timeseries</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id" />
                <separator />
                <filter string="Long" name="long" domain="[('quantity', '>', 0.0)]" />
                <filter string="Short" name="short" domain="[('quantity', '&lt;', 0.0)]" />
                <filter string="Closed" name="closed" domain="[('quantity', '=', 0.0)]" />
                <separator />
                <filter name="date_filter" date="date" />
                <separator />
                <filter string="Liquid Assets" name="liquid" domain="[('liquid', '=', True)]" />
                <filter string="Illiquid Assets" name="illiquid" domain="[('liquid', '=', False)]" />
                <separator />
                <filter string="Realized" name="realized" domain="[('prediction', '=', False)]" />
                <filter string="Prediction" name="prediction" domain="[('prediction', '=', True)]" />
                <separator />
                <filter string="1 year" name="1_year" domain="[('date','&gt;',(context_today() + relativedelta(days=-365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=365)).strftime('%Y-%m-%d'))]" />
                <filter string="2 years" name="2_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-2*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=2*365)).strftime('%Y-%m-%d'))]" />
                <filter string="3 years" name="3_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-3*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=3*365)).strftime('%Y-%m-%d'))]" />
                <filter string="4 years" name="4_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-4*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=4*365)).strftime('%Y-%m-%d'))]" />
                <filter string="5 years" name="5_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-5*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=5*365)).strftime('%Y-%m-%d'))]" />
                <filter string="6 years" name="6_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-6*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=6*365)).strftime('%Y-%m-%d'))]" />
                <filter string="7 years" name="7_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-7*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=7*365)).strftime('%Y-%m-%d'))]" />
                <filter string="8 years" name="8_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-8*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=8*365)).strftime('%Y-%m-%d'))]" />
                <filter string="9 years" name="9_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-9*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=9*365)).strftime('%Y-%m-%d'))]" />
                <filter string="10 years" name="10_years" domain="[('date','&gt;',(context_today() + relativedelta(days=-10*365)).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=10*365)).strftime('%Y-%m-%d'))]" />
                <group expand="1" string="Group by">
                    <filter string="Date" name="group_day" context="{'group_by': 'date:day'}" invisible="not context.get('search_default_group_day')" />
                    <filter string="Date" name="group_week" context="{'group_by': 'date:week'}" invisible="not context.get('search_default_group_week')" />
                    <filter string="Date" name="group_year" context="{'group_by': 'date:year'}" invisible="not context.get('search_default_group_year')" />
                    <filter string="Category" name="group_category_id" context="{'group_by': 'category_id'}" />
                    <filter string="Asset" name="group_asset_id" context="{'group_by': 'asset_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_compute_aggregate" model="ir.actions.server">
        <field name="name">Re-compute Value</field>
        <field name="model_id" ref="model_investment_timeseries" />
        <field name="binding_model_id" ref="model_investment_timeseries" />
        <field name="state">code</field>
        <field name="code">records._compute_aggregate()</field>
    </record>

    <record model="ir.actions.act_window" id="action_profits">
        <field name="name">Profits</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_group_day': 1, 'search_default_liquid': 1, 'search_default_4_years': 1, 'search_default_realized': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
            ]"
        />
    </record>

    <record model="ir.actions.act_window" id="action_positions">
        <field name="name">Positions</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_group_day': 1, 'search_default_liquid': 1, 'search_default_4_years': 1, 'search_default_realized': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('timeseries_position')}),
            ]"
        />
    </record>


    <record model="ir.actions.act_window" id="action_profits_per_asset">
        <field name="name">Profits per asset</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_group_week': 1, 'search_default_group_asset_id': 1, 'search_default_liquid': 1, 'search_default_4_years': 1, 'search_default_realized': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
            ]"
        />
    </record>

    <record model="ir.actions.act_window" id="action_positions_per_asset">
        <field name="name">Positions per asset</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_group_week': 1, 'search_default_group_asset_id': 1, 'search_default_liquid': 1, 'search_default_4_years': 1, 'search_default_realized': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('timeseries_position')}),
            ]"
        />
    </record>

    <record model="ir.actions.act_window" id="action_prediction_growth">
        <field name="name">Predicted growth</field>
        <field name="res_model">investment.timeseries</field>
        <field name="view_mode">graph,tree,form</field>
        <field name="context">{'search_default_group_year': 1, 'search_default_group_asset_id': 1, 'search_default_liquid': 1}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('timeseries_position')}),
            ]"
        />
    </record>

</odoo>