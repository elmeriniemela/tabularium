<odoo>
    <record id="transaction_import_tree" model="ir.ui.view">
        <field name="name">investment.transaction.import.list</field>
        <field name="model">investment.transaction.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="source" optional="show"/>
                <field name="portfolio_id" optional="show"/>
                <field name="validate_balances" widget="boolean_toggle" optional="show"/>
                <field name="transaction_ids" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="transaction_import_form" model="ir.ui.view">
        <field name="name">investment.transaction.import.form</field>
        <field name="model">investment.transaction.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" type="object" string="Import" icon="fa-file-excel-o"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="True"/>
                            <field name="file" filename="name"/>
                            <field name="validate_balances" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="portfolio_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <field name="transaction_ids"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="transaction_import_search" model="ir.ui.view">
        <field name="name">investment.transaction.import.search</field>
        <field name="model">investment.transaction.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source"/>
                <field name="portfolio_id"/>
                <field name="company_id"/>
                <filter name="filter_create_date" date="create_date"/>
                <separator/>
                <filter string="Validate Balances" name="filter_validate_balances" domain="[('validate_balances', '=', True)]"/>
                <filter string="Do Not Validate Balances" name="filter_not_validate_balances" domain="[('validate_balances', '=', False)]"/>
                <group>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Portfolio" name="group_portfolio_id" context="{'group_by': 'portfolio_id'}"/>
                    <filter string="Company" name="group_company_id" context="{'group_by': 'company_id'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transaction_imports" model="ir.actions.act_window">
        <field name="name">Transaction Imports</field>
        <field name="res_model">investment.transaction.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_investment_transaction_multi_import" model="ir.actions.server">
        <field name="name">Import transactions</field>
        <field name="model_id" ref="model_investment_transaction_import"/>
        <field name="binding_model_id" ref="model_investment_transaction_import"/>
        <field name="state">code</field>
        <field name="code">action = records.sorted('name').action_import()</field>
    </record>
</odoo>
