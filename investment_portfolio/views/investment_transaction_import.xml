<odoo>
    <record id="transaction_import_tree" model="ir.ui.view">
        <field name="name">investment.transaction.import.list</field>
        <field name="model">investment.transaction.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source"/>
                <field name="company_id" optional="hide"/>
                <field name="portfolio_id"/>
                <field name="validate_balances" widget="boolean_toggle"/>
                <field name="transaction_ids" optional="show"/>
            </list>
        </field>
    </record>

    <record id="transaction_import_form" model="ir.ui.view">
        <field name="name">investment.transaction.import.form</field>
        <field name="model">investment.transaction.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" type="object" string="Import" icon="fa-file-excel-o"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="True"/>
                            <field name="file" filename="name"/>
                            <field name="validate_balances" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="portfolio_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <field name="transaction_ids"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="transaction_import_search" model="ir.ui.view">
        <field name="name">investment.transaction.import.search</field>
        <field name="model">investment.transaction.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="portfolio_id"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="action_transaction_imports" model="ir.actions.act_window">
        <field name="name">Transaction Imports</field>
        <field name="res_model">investment.transaction.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_investment_transaction_multi_import" model="ir.actions.server">
        <field name="name">Import transactions</field>
        <field name="model_id" ref="model_investment_transaction_import"/>
        <field name="binding_model_id" ref="model_investment_transaction_import"/>
        <field name="state">code</field>
        <field name="code">action = records.sorted('name').action_import()</field>
    </record>
</odoo>
