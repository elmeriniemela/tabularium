<odoo>
    <record id="asset_price_tree" model="ir.ui.view">
        <field name="name">investment.asset.price.tree</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <tree editable="top" default_order="time desc" expand="1">
                <field name="time"/>
                <field name="price"/>
                <field name="prediction" optional="hide"/>
                <field name="currency_id" optional="show"/>
                <field name="asset_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="asset_price_form" model="ir.ui.view">
        <field name="name">investment.asset.price.form</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="time"/>
                            <field name="price"/>
                            <field name="prediction"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="not context.get('show_all')"/>
                            <field name="asset_id" invisible="not context.get('show_all')"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_price_search" model="ir.ui.view">
        <field name="name">investment.asset.price.search</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <filter name="time" date="time"/>
                <separator/>
                <filter string="Realized" name="realized" domain="[('prediction', '=', False)]"/>
                <filter string="Prediction" name="prediction" domain="[('prediction', '=', True)]"/>
                <separator/>
                <group expand="1" string="Group by">
                    <filter string="Time" name="group_time" context="{'group_by': 'time:week'}"/>
                    <filter string="Asset" name="group_asset_id" context="{'group_by': 'asset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_price_graph" model="ir.ui.view">
        <field name="name">investment.asset.price.graph</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_price_interpolate_cagr" model="ir.actions.server">
        <field name="name">Interpolate CAGR</field>
        <field name="model_id" ref="model_investment_asset_price"/>
        <field name="binding_model_id" ref="model_investment_asset_price"/>
        <field name="state">code</field>
        <field name="code">records.interpolate_cagr()</field>
    </record>


    <record id="action_prices" model="ir.actions.act_window">
        <field name="name">Asset Prices</field>
        <field name="res_model">investment.asset.price</field>
        <field name="view_mode">tree,graph,form</field>
    </record>

</odoo>