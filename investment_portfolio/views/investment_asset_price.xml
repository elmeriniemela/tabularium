<odoo>
    <record model="ir.ui.view" id="asset_price_tree">
        <field name="name">investment.asset.price.tree</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="time"/>
                <field name="price"/>
                <field name="currency_id" optional="hide"/>
                <field name="asset_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="asset_price_form">
        <field name="name">investment.asset.price.form</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="time"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="not context.get('show_all')"/>
                            <field name="asset_id" invisible="not context.get('show_all')"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_price_search" model="ir.ui.view">
        <field name="name">investment.asset.price.search</field>
        <field name="model">investment.asset.price</field>
        <field name="arch" type="xml">
            <search>
                <filter name="time" date="time"/>
                <group expand="1" string="Group by">
                    <filter string="Time" name="group_time" context="{'group_by': 'time'}"/>
                    <filter string="Asset" name="group_asset_id" context="{'group_by': 'asset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="asset_price_graph">
         <field name="name">investment.asset.price.graph</field>
         <field name="model">investment.asset.price</field>
         <field name="arch" type="xml">
             <graph type="line">
                 <field name="price" type="measure"/>
             </graph>
         </field>
    </record>




    <record model="ir.actions.act_window" id="asset_price_action_window">
        <field name="name">Asset Prices</field>
        <field name="res_model">investment.asset.price</field>
        <field name="view_mode">tree,graph,form</field>
    </record>

    <menuitem id="asset_price_menu" action="asset_price_action_window" parent="root_menu" sequence="1"/>

</odoo>