<odoo>
    <record id="asset_split_tree" model="ir.ui.view">
        <field name="name">investment.asset.split.list</field>
        <field name="model">investment.asset.split</field>
        <field name="arch" type="xml">
            <list>
                <field name="price_id" optional="show"/>
                <field name="time" optional="show"/>
                <field name="factor" optional="show"/>
                <field name="asset_id" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="asset_split_form" model="ir.ui.view">
        <field name="name">investment.asset.split.form</field>
        <field name="model">investment.asset.split</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="price_id"/>
                        </group>
                        <group>
                            <field name="time"/>
                            <field name="factor"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_split_search" model="ir.ui.view">
        <field name="name">investment.asset.split.search</field>
        <field name="model">investment.asset.split</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="price_id"/>
                <filter name="time" date="time"/>
                <filter name="filter_create_date" date="create_date"/>
                <group>
                    <filter string="Asset" name="group_asset_id" context="{'group_by': 'asset_id'}"/>
                    <filter string="Time" name="group_time" context="{'group_by': 'time:month'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_asset_splits" model="ir.actions.act_window">
        <field name="name">Splits</field>
        <field name="res_model">investment.asset.split</field>
        <field name="view_mode">list,form,graph</field>
    </record>

</odoo>