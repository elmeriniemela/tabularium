<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="investment_portfolio.PositionDashboard">
        <div t-ref="root" style="overflow: auto; height: 100%;">
            <div class="m-2">
                <div class="row gx-2 gy-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Liquid Position</h5>
                                <div class="card-text m-2">
                                    <div class="row o_kpi_row">
                                        <div class="col-4">
                                            <label>Position</label>
                                        </div>
                                        <div class="col-8 text-end">
                                            <span t-esc="state.liquid.position"/>
                                        </div>
                                    </div>
                                    <div class="row o_kpi_row">
                                        <div class="col-4">
                                            <label>Profit</label>
                                        </div>
                                        <div class="col-8 text-end">
                                            <span t-esc="state.liquid.profit" t-att-class="state.liquid.profitClass"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_dashboard_graph">
                                    <canvas t-ref="canvas"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Top Gainer</h5>

                                <div class="card-text">
                                    <div class="row">
                                        <div class="col">
                                            <label>Position</label>
                                        </div>
                                        <div class="col text-end">
                                            <span t-esc="state.liquid.position"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col">
                                            <label>Profit</label>
                                        </div>
                                        <div class="col text-end">
                                            <span t-esc="state.liquid.profit" t-att-class="state.liquid.profitClass"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_dashboard_graph">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>