<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">


    <t t-name="investment_portfolio.PieChart">
        <div class="o_dashboard_graph">
            <canvas t-ref="canvas"/>
        </div>
    </t>

    <t t-name="investment_portfolio.PositionDashboard">
        <div t-ref="root" style="overflow: auto; height: 100%;">
            <div class="m-2">
                <div class="row gx-2 gy-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Liquid Portfolios</h5>
                                <div class="card-text m-2">
                                    <div class="row o_kpi_row">
                                        <div class="col-5">
                                            <label>Total Position</label>
                                        </div>
                                        <div class="col-7 text-end">
                                            <span t-esc="state.liquid.position"/>
                                        </div>
                                    </div>
                                    <div class="row o_kpi_row">
                                        <div class="col-5">
                                            <label>Total Profit</label>
                                        </div>
                                        <div class="col-7 text-end">
                                            <span t-esc="state.liquid.profit" t-att-class="state.liquid.profitClass"/>
                                        </div>
                                    </div>
                                </div>
                                <PieChart labels="state.liquid.chart.labels" data="state.liquid.chart.data" title="state.liquid.chart.title" onPieSliceClick.bind="onPieSliceClick" />
                            </div>
                        </div>
                    </div>
                    <t t-foreach="state.positions" t-as="position" t-key="position.id">
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <span t-esc="position.name"/>
                                    </h5>
                                    <div class="card-text m-2">
                                        <div class="row o_kpi_row">
                                            <div class="col-5">
                                                <label>Position</label>
                                            </div>
                                            <div class="col-7 text-end">
                                                <span t-esc="position.position"/>
                                            </div>
                                        </div>
                                        <div class="row o_kpi_row">
                                            <div class="col-5">
                                                <label>Profit</label>
                                            </div>
                                            <div class="col-7 text-end">
                                                <span t-esc="position.profit" t-att-class="position.profitClass"/>
                                            </div>
                                        </div>
                                        <div class="row o_kpi_row">
                                            <div class="col-5">
                                                <label>1 day</label>
                                            </div>
                                            <div class="col-7 text-end">
                                                <span t-esc="position.daily_price" t-att-class="position.daily_priceClass"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>