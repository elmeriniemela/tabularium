<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">


    <t t-name="investment_portfolio.PieChart">
        <div class="o_dashboard_graph o_pie_chart" t-att-style="props.style">
            <canvas t-ref="canvas"/>
        </div>
    </t>

    <t t-name="investment_portfolio.LineChart">
        <div class="o_dashboard_graph o_line_chart" t-att-style="props.style">
            <canvas t-ref="canvas"/>
        </div>
    </t>

    <t t-name="investment_portfolio.PositionDashboard">
        <div t-ref="root" style="overflow: auto; height: 100%;">
            <div class="m-2">
                <div class="row gx-2 gy-2">
                    <div class="col-sm-6 col-lg-4 col-xxl-3">
                        <div class="card o_dasboard_card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col">
                                        <h4 class="card-title" t-on-click="() => this.onClickOpenLiquidPortfolios()">
                                            <a href="#">Liquid Portfolios</a>
                                        </h4>
                                    </div>
                                    <div class="col text-end">
                                        <button type="button" class="btn" style="padding: 0px;" data-hotkey="r" t-on-click="() => this.onClickRefreshAll()" data-bounce-button="">
                                            <i class="fa fa-refresh" style="height: 19px" aria-label="Refresh" title="Refresh"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-text m-2">
                                    <div class="row gx-0 gy-0 o_kpi_row">
                                        <div class="col-4">
                                            <label>Position</label>
                                        </div>
                                        <div class="col-8 text-end">
                                            <span t-esc="state.liquid.position.fmtValue"/>
                                        </div>
                                    </div>
                                    <t t-if="state.periods.length > 0">
                                        <div  class="row gx-0 gy-0 o_kpi_row" t-foreach="state.periods" t-as="record" t-key="record.id">
                                            <div class="col-4">
                                                <label t-esc="record.name"/>
                                            </div>
                                            <div class="col-8 text-end d-flex justify-content-end align-items-right">
                                                <span t-esc="record.profit.fmtValue" t-att-class="record.profit.className"/>
                                                <span style="width: 15px;"> | </span>
                                                <span style="width: 60px;" t-esc="record.annualized_irr.fmtValue" t-att-class="record.annualized_irr.className"/>
                                            </div>
                                        </div>
                                    </t>
                                    <div t-else="" class="row gx-0 gy-0 o_kpi_row">
                                        <div class="col-4">
                                            <label>Profit</label>
                                        </div>
                                        <div class="col-8 text-end">
                                            <span t-esc="state.liquid.profit.fmtValue" t-att-class="state.liquid.profit.className"/>
                                        </div>
                                    </div>
                                </div>
                                <PieChart labels="state.liquid.chart.labels" data="state.liquid.chart.data" title="state.liquid.chart.title" onPieSliceClick.bind="onPieSliceClick" style="''" />
                            </div>
                        </div>
                    </div>
                    <t t-foreach="state.positions" t-as="record" t-key="record.id">
                        <div class="col-sm-6 col-lg-4 col-xxl-3">
                            <div class="card o_dasboard_card">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col">
                                            <h4 class="card-title" t-on-click="() => this.onClickOpenPosition(record)">
                                                <a t-esc="record.name" href="#"/>
                                            </h4>
                                        </div>
                                        <div class="col text-end">
                                            <button type="button" class="btn" style="padding: 0px;" data-hotkey="r" t-on-click="() => this.onClickRefreshPrice(record)" data-bounce-button="">
                                                <i class="fa fa-refresh" style="height: 19px" aria-label="Refresh" title="Refresh"/>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-text m-2">
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>Last Price</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.last_price"/>
                                                <span> </span>
                                                <time class="timeago" t-att-datetime="record.last_update_iso" t-esc="record.last_update"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>Position</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.position.fmtValue"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>Profit</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.profit.fmtValue" t-att-class="record.profit.className"/>
                                                <span> / </span>
                                                <span t-esc="record.profit_percent.fmtValue" t-att-class="record.profit_percent.className"/>
                                            </div>
                                        </div>


                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>1 Day</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.daily_price.fmtValue" t-att-class="record.daily_price.className"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>1 Week</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.weekly_price.fmtValue" t-att-class="record.weekly_price.className"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>1 Month</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.monthly_price.fmtValue" t-att-class="record.monthly_price.className"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>6 Months</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.six_month_price.fmtValue" t-att-class="record.six_month_price.className"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>YTD</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.ytd_price.fmtValue" t-att-class="record.ytd_price.className"/>
                                            </div>
                                        </div>
                                        <div class="row gx-0 gy-0 o_kpi_row">
                                            <div class="col-4">
                                                <label>1 Year</label>
                                            </div>
                                            <div class="col-8 text-end">
                                                <span t-esc="record.one_year_price.fmtValue" t-att-class="record.one_year_price.className"/>
                                            </div>
                                        </div>
                                    </div>
                                    <LineChart labels="record.chart.labels" data="record.chart.data" title="record.chart.title" label="record.chart.label" style="''"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>