<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base.module_category_investment_portfolio" model="ir.module.category">
        <field name="sequence">9</field>
    </record>

    <record id="res_groups_privilege_investment_portfolio" model="res.groups.privilege">
        <field name="name">Investment Portfolio</field>
        <field name="category_id" ref="base.module_category_investment_portfolio"/>
    </record>

    <record id="group_investment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_investment_portfolio"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">User.</field>
    </record>

    <record id="group_investment_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator.</field>
        <field name="privilege_id" ref="res_groups_privilege_investment_portfolio"/>
        <field name="implied_ids" eval="[(4, ref('group_investment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="comp_rule_investment_position" model="ir.rule">
        <field name="name">investment_position company rule</field>
        <field name="model_id" ref="model_investment_position"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_timeseries" model="ir.rule">
        <field name="name">investment_timeseries company rule</field>
        <field name="model_id" ref="model_investment_timeseries"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_milestone" model="ir.rule">
        <field name="name">investment_milestone company rule</field>
        <field name="model_id" ref="model_investment_milestone"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_period" model="ir.rule">
        <field name="name">investment_period company rule</field>
        <field name="model_id" ref="model_investment_period"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_position_transaction" model="ir.rule">
        <field name="name">investment_position_transaction company rule</field>
        <field name="model_id" ref="model_investment_position_transaction"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_position_move" model="ir.rule">
        <field name="name">investment_position_move company rule</field>
        <field name="model_id" ref="model_investment_position_move"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_position_note" model="ir.rule">
        <field name="name">investment_position_note company rule</field>
        <field name="model_id" ref="model_investment_position_note"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_transaction_import" model="ir.rule">
        <field name="name">investment_transaction_import company rule</field>
        <field name="model_id" ref="model_investment_transaction_import"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="comp_rule_investment_asset_realized" model="ir.rule">
        <field name="name">investment_asset_realized company rule</field>
        <field name="model_id" ref="model_investment_asset_realized"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>


    <record id="owner_rule_investment_asset" model="ir.rule">
        <field name="name">investment_asset owner rule</field>
        <field name="model_id" ref="model_investment_asset"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
    </record>

    <record id="viewer_rule_investment_asset" model="ir.rule">
        <field name="name">investment_asset viewer rule</field>
        <field name="model_id" ref="model_investment_asset"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('liquid', '=', True), ('company_ids', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_investment_user'))]"/>
    </record>



    <record id="owner_rule_investment_asset_price" model="ir.rule">
        <field name="name">investment_asset_price owner rule</field>
        <field name="model_id" ref="model_investment_asset_price"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('asset_id.company_ids', 'in', company_ids)]</field>
    </record>

    <record id="owner_rule_investment_asset_split" model="ir.rule">
        <field name="name">investment_asset_split owner rule</field>
        <field name="model_id" ref="model_investment_asset_split"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('asset_id.company_ids', 'in', company_ids)]</field>
    </record>

</odoo>
