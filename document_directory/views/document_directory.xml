<odoo>
    <record id="directory_tree" model="ir.ui.view">
        <field name="name">document.directory.list</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <list default_order="write_date desc">
                <field name="name" optional="show"/>
                <field name="attachment_ids" widget="many2many_tags" optional="show"/>
                <field name="write_date" optional="show"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="directory_form" model="ir.ui.view">
        <field name="name">document.directory.form</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title" style="margin-left: auto; margin-right: auto; width: 600px;">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <field name="message_main_attachment_id" options="{'no_create_edit': True}" domain="[('res_model', '=', 'document.directory'), ('res_id', '=', id)]"/>
                        </group>
                    </div>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="directory_search" model="ir.ui.view">
        <field name="name">document.directory.search</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="attachment_ids"/>
            </search>
        </field>
    </record>

    <record id="action_document_dirs" model="ir.actions.act_window">
        <field name="name">Document Directories</field>
        <field name="res_model">document.directory</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Documents" id="root_menu" web_icon="document_directory,static/description/icon.png" sequence="2" action="action_document_dirs"/>


</odoo>