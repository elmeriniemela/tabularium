<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_documents" model="res.groups.privilege">
        <field name="name">Documents</field>
        <field name="category_id" ref="base.module_category_documents"/>
    </record>

    <record id="group_documents_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_documents"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">User.</field>
    </record>

    <record id="group_documents_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator.</field>
        <field name="privilege_id" ref="res_groups_privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('group_documents_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


</odoo>
