<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_base_module_uninstall" model="ir.ui.view">
        <field name="name">view_base_module_uninstall</field>
        <field name="model">base.module.uninstall</field>
        <field name="inherit_id" ref="base.view_base_module_uninstall"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="inside">
                <button data-hotkey="s" string="Skip" class="btn-secondary" type="object" name="action_next"/>
            </xpath>
        </field>
    </record>

    <record id="action_multi_uninstall" model="ir.actions.act_window">
        <field name="name">Uninstall Modules</field>
        <field name="res_model">base.module.uninstall</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'active_ids': active_ids, 'default_module_id': active_id}</field>
        <field name="binding_model_id" ref="base.model_ir_module_module"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
