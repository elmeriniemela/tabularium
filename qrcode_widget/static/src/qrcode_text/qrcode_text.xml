<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="qrcode_widget.QRCodeTextField" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//input" position="after">
            <button type="button" class="btn m-0 py-0 px-2 fa fa-qrcode o_qrcode_text_scan"
                    title="Scan QR code" aria-label="Scan QR code" t-on-click="scanQRCode"/>
        </xpath>
    </t>

    <t t-name="qrcode_widget.QRCodeScanner">
        <video t-ref="video" class="w-100 h-100" muted="true" autoplay="true" playsinline="true"
               t-on-loadeddata="detect"/>
    </t>

    <t t-name="qrcode_widget.QRCodeDialog">
        <Dialog title.translate="QR Code Scanner" fullscreen="true" footer="false"
                contentClass="'o_qrcode_scanner_modal'">
            <div t-if="state.supported" class="position-relative h-100">
                <QRCodeScanner onResult.bind="onResult" onError.bind="onError"/>
                <div t-if="state.progress"
                     class="position-absolute bottom-0 start-50 translate-middle-x mb-3 py-2 px-3 rounded bg-dark text-white"
                     t-out="state.progress"/>
            </div>
            <div t-else="" class="h-100 d-flex flex-column justify-content-center align-items-center gap-1">
                <i class="fa fa-2x fa-camera text-muted"/>
                <strong>Unable to access camera</strong>
                <span class="text-muted" t-out="state.error"/>
            </div>
        </Dialog>
    </t>
</templates>
